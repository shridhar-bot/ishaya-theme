{% doc %}
  Bottom sheet shown after a product is added to the bag. Replaces opening the
  cart drawer on add-to-cart: it slides up from the bottom, highlights the
  product that was just added, and offers "View bag" (opens the drawer) and
  "Checkout". It closes itself after a few seconds unless hovered or focused.

  Call from JS: window.showCartNotification(lineItem)
  where lineItem is the JSON returned by /cart/add.js (a single item, or the
  first entry of its `items` array).
{% enddoc %}

<div
  id="CartNotification"
  class="ishaya-cart-sheet"
  role="dialog"
  aria-modal="false"
  aria-labelledby="CartNotificationHeading"
  hidden
>
  <div class="ishaya-cart-sheet__panel">
    <span class="ishaya-cart-sheet__handle" aria-hidden="true"></span>

    <div class="ishaya-cart-sheet__head">
      <p id="CartNotificationHeading" class="ishaya-cart-sheet__heading">
        <span class="ishaya-cart-sheet__tick" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" focusable="false"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </span>
        ADDED TO YOUR BAG
      </p>
      <button type="button" class="ishaya-cart-sheet__close" data-cart-sheet-close aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="ishaya-cart-sheet__product">
      <div class="ishaya-cart-sheet__media" data-cart-sheet-media></div>
      <div class="ishaya-cart-sheet__info">
        <p class="ishaya-cart-sheet__name">
          <mark class="ishaya-cart-sheet__highlight" data-cart-sheet-name></mark>
        </p>
        <p class="ishaya-cart-sheet__variant" data-cart-sheet-variant hidden></p>
        <p class="ishaya-cart-sheet__meta">
          <span data-cart-sheet-qty></span>
          <span class="ishaya-cart-sheet__price" data-cart-sheet-price></span>
        </p>
      </div>
    </div>

    <div class="ishaya-cart-sheet__actions">
      <button type="button" class="btn btn--secondary ishaya-cart-sheet__btn" data-cart-sheet-view>
        VIEW BAG <span data-cart-sheet-count></span>
      </button>
      <a href="/checkout" class="btn btn--primary ishaya-cart-sheet__btn">
        CHECKOUT
      </a>
    </div>

    <span class="ishaya-cart-sheet__timer" data-cart-sheet-timer aria-hidden="true"></span>
  </div>
</div>

<style>
  .ishaya-cart-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9998;
    display: flex;
    justify-content: center;
    padding: 0 1rem calc(1rem + env(safe-area-inset-bottom));
    pointer-events: none;
  }

  .ishaya-cart-sheet[hidden] {
    display: none;
  }

  .ishaya-cart-sheet__panel {
    position: relative;
    width: 100%;
    max-width: 440px;
    padding: 0.9rem 1.1rem 1.1rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background-color: var(--color-surface);
    color: var(--color-foreground);
    box-shadow: var(--shadow-floating);
    pointer-events: auto;
    transform: translateY(calc(100% + 2rem));
    opacity: 0;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .ishaya-cart-sheet.is-open .ishaya-cart-sheet__panel {
    transform: translateY(0);
    opacity: 1;
  }

  .ishaya-cart-sheet__handle {
    display: none;
    width: 36px;
    height: 4px;
    margin: -0.25rem auto 0.6rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-border);
  }

  .ishaya-cart-sheet__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .ishaya-cart-sheet__heading {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--color-muted);
  }

  .ishaya-cart-sheet__tick {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .ishaya-cart-sheet__close {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .ishaya-cart-sheet__close:hover {
    background-color: var(--glass-bg-hover, rgba(0, 0, 0, 0.06));
  }

  .ishaya-cart-sheet__product {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .ishaya-cart-sheet__media {
    flex: 0 0 72px;
    width: 72px;
    height: 90px;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--color-background);
  }

  .ishaya-cart-sheet__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ishaya-cart-sheet__info {
    min-width: 0;
    flex: 1;
  }

  .ishaya-cart-sheet__name {
    margin: 0 0 0.3rem;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
  }

  /* The highlighted product name: an accent marker stroke that sweeps in. */
  .ishaya-cart-sheet__highlight {
    padding: 0.05em 0.3em;
    border-radius: 4px;
    color: var(--color-on-accent);
    background-color: transparent;
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-repeat: no-repeat;
    background-size: 0% 100%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.25s, color 0.2s ease 0.25s;
  }

  .ishaya-cart-sheet:not(.is-open) .ishaya-cart-sheet__highlight {
    color: var(--color-foreground);
  }

  .ishaya-cart-sheet.is-open .ishaya-cart-sheet__highlight {
    background-size: 100% 100%;
  }

  .ishaya-cart-sheet__variant {
    margin: 0 0 0.25rem;
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .ishaya-cart-sheet__meta {
    display: flex;
    gap: 0.6rem;
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .ishaya-cart-sheet__price {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .ishaya-cart-sheet__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .ishaya-cart-sheet__btn {
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  /* Auto-close countdown along the bottom edge */
  .ishaya-cart-sheet__timer {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 100%;
    background-color: var(--color-accent);
    transform-origin: left center;
    transform: scaleX(0);
  }

  .ishaya-cart-sheet.is-counting .ishaya-cart-sheet__timer {
    animation: ishayaCartSheetTimer var(--cart-sheet-duration, 5s) linear forwards;
  }

  .ishaya-cart-sheet.is-paused .ishaya-cart-sheet__timer {
    animation-play-state: paused;
  }

  @keyframes ishayaCartSheetTimer {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
  }

  /* Phones: a true bottom sheet, edge to edge */
  @media (max-width: 749px) {
    .ishaya-cart-sheet {
      padding: 0;
    }

    .ishaya-cart-sheet__panel {
      max-width: none;
      border-width: 1px 0 0;
      border-radius: 22px 22px 0 0;
      padding-bottom: calc(1.1rem + env(safe-area-inset-bottom));
    }

    .ishaya-cart-sheet__handle {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ishaya-cart-sheet__panel,
    .ishaya-cart-sheet__highlight {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    const sheet = document.getElementById('CartNotification');
    if (!sheet) return;

    const DURATION = 5000;
    const moneyFormat = {{ shop.money_format | json }};
    const nameEl = sheet.querySelector('[data-cart-sheet-name]');
    const variantEl = sheet.querySelector('[data-cart-sheet-variant]');
    const qtyEl = sheet.querySelector('[data-cart-sheet-qty]');
    const priceEl = sheet.querySelector('[data-cart-sheet-price]');
    const mediaEl = sheet.querySelector('[data-cart-sheet-media]');
    const countEl = sheet.querySelector('[data-cart-sheet-count]');

    let hideTimer = null;
    let remaining = DURATION;
    let startedAt = 0;

    function formatMoney(cents) {
      const value = (Number(cents) || 0) / 100;
      const fmt = function (decimals, thousands, decimal) {
        const parts = value.toFixed(decimals).split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, thousands);
        return parts.join(decimal);
      };
      return String(moneyFormat || '$' + '{' + '{amount}}').replace(/\{\{\s*(\w+)\s*\}\}/, function (_, key) {
        switch (key) {
          case 'amount_no_decimals': return fmt(0, ',', '.');
          case 'amount_with_comma_separator': return fmt(2, '.', ',');
          case 'amount_no_decimals_with_comma_separator': return fmt(0, '.', ',');
          case 'amount_with_apostrophe_separator': return fmt(2, "'", '.');
          default: return fmt(2, ',', '.');
        }
      });
    }

    function imageUrl(src, width) {
      if (!src) return '';
      try {
        const url = new URL(src, window.location.origin);
        url.searchParams.set('width', width);
        return url.toString();
      } catch (e) {
        return src;
      }
    }

    function clearTimer() {
      if (hideTimer) {
        window.clearTimeout(hideTimer);
        hideTimer = null;
      }
    }

    function startTimer(ms) {
      clearTimer();
      remaining = ms;
      startedAt = Date.now();
      hideTimer = window.setTimeout(hide, ms);
    }

    function pause() {
      if (!hideTimer) return;
      clearTimer();
      remaining = Math.max(0, remaining - (Date.now() - startedAt));
      sheet.classList.add('is-paused');
    }

    function resume() {
      if (hideTimer || !sheet.classList.contains('is-open')) return;
      if (sheet.contains(document.activeElement) || sheet.matches(':hover')) return;
      sheet.classList.remove('is-paused');
      startTimer(remaining);
    }

    function hide() {
      clearTimer();
      sheet.classList.remove('is-open', 'is-counting', 'is-paused');
      window.setTimeout(function () {
        if (!sheet.classList.contains('is-open')) sheet.hidden = true;
      }, 450);
    }

    function updateCount() {
      if (!countEl) return;
      fetch((window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : '/') + 'cart.js')
        .then(function (res) { return res.json(); })
        .then(function (cart) {
          countEl.textContent = cart.item_count ? '(' + cart.item_count + ')' : '';
        })
        .catch(function () {});
    }

    window.showCartNotification = function (item) {
      if (!item) return;
      if (item.items && item.items.length) item = item.items[0];

      nameEl.textContent = item.product_title || item.title || 'Your item';

      const variant = item.variant_title && item.variant_title !== 'Default Title' ? item.variant_title : '';
      variantEl.textContent = variant;
      variantEl.hidden = !variant;

      qtyEl.textContent = 'Qty ' + (item.quantity || 1);
      priceEl.textContent = formatMoney(item.final_price != null ? item.final_price : item.price);

      mediaEl.innerHTML = '';
      const src = item.featured_image && item.featured_image.url ? item.featured_image.url : item.image;
      if (src) {
        const img = document.createElement('img');
        img.src = imageUrl(src, 200);
        img.alt = (item.featured_image && item.featured_image.alt) || nameEl.textContent;
        img.width = 72;
        img.height = 90;
        mediaEl.appendChild(img);
      }

      if (countEl) countEl.textContent = '';
      updateCount();

      // Restart the entrance (and the highlight sweep) on every add.
      sheet.classList.remove('is-open', 'is-counting', 'is-paused');
      sheet.hidden = false;
      sheet.style.setProperty('--cart-sheet-duration', DURATION + 'ms');
      void sheet.offsetWidth;
      sheet.classList.add('is-open', 'is-counting');
      startTimer(DURATION);
    };

    window.hideCartNotification = hide;

    sheet.querySelector('[data-cart-sheet-close]').addEventListener('click', hide);

    sheet.querySelector('[data-cart-sheet-view]').addEventListener('click', function () {
      hide();
      if (typeof window.openCartDrawer === 'function') window.openCartDrawer();
    });

    sheet.addEventListener('mouseenter', pause);
    sheet.addEventListener('mouseleave', resume);
    sheet.addEventListener('focusin', pause);
    sheet.addEventListener('focusout', function () {
      window.setTimeout(resume, 0);
    });

    document.addEventListener('keydown', function (evt) {
      if (evt.key === 'Escape' && sheet.classList.contains('is-open')) hide();
    });

    // Swipe down to dismiss on touch screens.
    let touchStartY = null;
    sheet.addEventListener('touchstart', function (evt) {
      touchStartY = evt.touches[0].clientY;
    }, { passive: true });
    sheet.addEventListener('touchend', function (evt) {
      if (touchStartY === null) return;
      const dy = evt.changedTouches[0].clientY - touchStartY;
      touchStartY = null;
      if (dy > 50) hide();
    }, { passive: true });
  })();
</script>
