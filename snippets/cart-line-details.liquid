{% doc %}
  Renders the extra details of a cart line: what a bundle contains
  (Shopify Bundles `item_components`), the discounts applied to the line,
  and any customer-facing line item properties. Properties whose name starts
  with an underscore are private to apps and are not shown.

  Renders nothing when the line has none of these.

  @param {object} item - The cart line item
  @param {string} class_prefix - BEM block used for class names, e.g. 'ishaya-cart-drawer'

  @example
  {% render 'cart-line-details', item: item, class_prefix: 'ishaya-cart-drawer' %}
{% enddoc %}

{%- liquid
  assign visible_properties = 0
  for property in item.properties
    assign first_char = property.first | slice: 0
    if property.last != blank and first_char != '_'
      assign visible_properties = visible_properties | plus: 1
    endif
  endfor
-%}

{%- if item.item_components.size > 0 -%}
  <div class="{{ class_prefix }}__bundle">
    <span class="{{ class_prefix }}__bundle-label">Includes</span>
    <ul class="{{ class_prefix }}__bundle-list" role="list">
      {%- for component in item.item_components -%}
        <li class="{{ class_prefix }}__bundle-item">
          <span class="{{ class_prefix }}__bundle-qty">{{ component.quantity }} ×</span>
          <span class="{{ class_prefix }}__bundle-name">
            {{- component.product.title | escape -}}
            {%- unless component.product.has_only_default_variant -%}
              <span class="{{ class_prefix }}__bundle-variant"> · {{ component.variant.title | escape }}</span>
            {%- endunless -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{%- if visible_properties > 0 -%}
  <dl class="{{ class_prefix }}__properties">
    {%- for property in item.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and first_char != '_' -%}
        <div class="{{ class_prefix }}__property">
          <dt>{{ property.first | escape }}:</dt>
          <dd>
            {%- if property.last contains '/uploads/' -%}
              <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last | escape }}</a>
            {%- else -%}
              {{ property.last | escape }}
            {%- endif -%}
          </dd>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </dl>
{%- endif -%}

{%- if item.line_level_discount_allocations.size > 0 -%}
  <ul class="{{ class_prefix }}__discounts" role="list">
    {%- for allocation in item.line_level_discount_allocations -%}
      <li class="{{ class_prefix }}__discount">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
        <span>{{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})</span>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}
