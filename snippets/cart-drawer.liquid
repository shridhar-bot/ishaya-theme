{% doc %}
  Renders the global slide-out cart drawer with real-time AJAX line-item updates,
  animated free shipping progress calculator, order note, and checkout actions.
{% enddoc %}

{%- liquid
  assign threshold_dollars = settings.free_shipping_threshold | default: 250
  assign threshold_cents = threshold_dollars | times: 100
  assign diff_cents = threshold_cents | minus: cart.total_price
  assign progress_percent = cart.total_price | times: 100.0 | divided_by: threshold_cents | at_most: 100 | round
-%}

<div
  id="CartDrawer"
  class="ishaya-cart-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Shopping Bag"
  hidden
>
  <div class="ishaya-cart-drawer__backdrop" data-close-cart tabindex="-1"></div>

  <div class="ishaya-cart-drawer__panel glass-panel">
    <!-- Drawer Header -->
    <div class="ishaya-cart-drawer__header">
      <div class="ishaya-cart-drawer__header-title-wrap">
        <h2 class="ishaya-cart-drawer__title">SHOPPING BAG</h2>
        <span
          id="CartDrawerCountBadge"
          class="ishaya-cart-drawer__count-badge{% if cart.item_count == 0 %} ishaya-cart-drawer__count-badge--hidden{% endif %}"
        >
          {{ cart.item_count }}
        </span>
      </div>

      <button
        type="button"
        class="ishaya-cart-drawer__close-btn"
        data-close-cart
        aria-label="Close shopping bag"
      >
        {% render 'icons', name: 'close', width: 18, height: 18 %}
      </button>
    </div>

    <!-- Free Shipping Calculator Bar -->
    <div class="ishaya-cart-drawer__shipping-bar" id="CartDrawerShippingBar">
      <div class="ishaya-cart-drawer__shipping-message" id="CartDrawerShippingMsg">
        {%- if diff_cents > 0 -%}
          Add <strong id="CartShippingDiff">{{ diff_cents | money }}</strong> more to unlock complimentary worldwide shipping.
        {%- else -%}
          <span class="ishaya-cart-drawer__shipping-unlocked">
            Complimentary worldwide shipping unlocked ✓
          </span>
        {%- endif -%}
      </div>
      <div class="ishaya-cart-drawer__progress-track" aria-hidden="true">
        <div
          class="ishaya-cart-drawer__progress-fill"
          id="CartShippingProgressFill"
          style="width: {{ progress_percent }}%;"
        ></div>
      </div>
    </div>

    <!-- Drawer Body: Line Items or Empty State -->
    <div class="ishaya-cart-drawer__body" id="CartDrawerBody">
      {%- if cart.item_count > 0 -%}
        <div class="ishaya-cart-drawer__items-list" id="CartDrawerItemsList">
          {%- for item in cart.items -%}
            <div class="ishaya-cart-drawer__item" data-line-item-key="{{ item.key }}">
              <!-- Item Media -->
              <a href="{{ item.url }}" class="ishaya-cart-drawer__item-media glass-panel" aria-label="{{ item.product.title | escape }}">
                {%- if item.image -%}
                  {{
                    item.image
                    | image_url: width: 300, height: 400, crop: 'center'
                    | image_tag:
                      loading: 'lazy',
                      class: 'ishaya-cart-drawer__item-img',
                      alt: item.image.alt | default: item.product.title | escape
                  }}
                {%- else -%}
                  <div class="ishaya-cart-drawer__placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </a>

              <!-- Item Content -->
              <div class="ishaya-cart-drawer__item-content">
                <div class="ishaya-cart-drawer__item-header">
                  <h3 class="ishaya-cart-drawer__item-title">
                    <a href="{{ item.url }}" class="ishaya-cart-drawer__item-link">
                      {{ item.product.title }}
                    </a>
                  </h3>
                  <button
                    type="button"
                    class="ishaya-cart-drawer__remove-btn"
                    data-remove-line="{{ item.key }}"
                    aria-label="Remove {{ item.title | escape }}"
                  >
                    {% render 'icons', name: 'close', width: 14, height: 14 %}
                  </button>
                </div>

                {%- unless item.product.has_only_default_variant -%}
                <div class="ishaya-cart-drawer__size-row">
                  {%- for option in item.product.options_with_values -%}
                    {%- assign option_name = option.name | downcase -%}

                    {%- if option_name == 'size' -%}
                      <label class="ishaya-cart-drawer__size-label">
                        SIZE
                        <select
                          class="ishaya-cart-drawer__size-select"
                          data-cart-size-change
                          data-line-key="{{ item.key }}"
                          data-current-variant="{{ item.variant.id }}"
                          aria-label="Change size for {{ item.product.title | escape }}"
                        >
                          {%- assign size_index = forloop.index0 -%}

                          {%- for variant in item.product.variants -%}
                            {%- assign same_other_options = true -%}

                            {%- for product_option in item.product.options_with_values -%}
                              {%- assign option_index = forloop.index0 -%}

                              {%- unless option_index == size_index -%}
                                {%- if variant.options[option_index] != item.variant.options[option_index] -%}
                                  {%- assign same_other_options = false -%}
                                {%- endif -%}
                              {%- endunless -%}
                            {%- endfor -%}

                            {%- if same_other_options -%}
                              <option
                                value="{{ variant.id }}"
                                {% if variant.id == item.variant.id %}selected{% endif %}
                                {% unless variant.available %}disabled{% endunless %}
                              >
                                {{ variant.options[size_index] }}
                                {% unless variant.available %} - Sold Out{% endunless %}
                              </option>
                            {%- endif -%}
                          {%- endfor -%}
                        </select>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endunless -%}

                <div class="ishaya-cart-drawer__item-footer">
                  <!-- Stepper -->
                  <div class="ishaya-cart-drawer__stepper glass-panel">
                    <button
                      type="button"
                      class="ishaya-cart-drawer__stepper-btn"
                      data-action="minus"
                      data-key="{{ item.key }}"
                      data-qty="{{ item.quantity | minus: 1 }}"
                      aria-label="Decrease quantity for {{ item.title | escape }}"
                    >
                      {% render 'icons', name: 'minus', width: 10, height: 10 %}
                    </button>
                    <span class="ishaya-cart-drawer__stepper-qty">{{ item.quantity }}</span>
                    <button
                      type="button"
                      class="ishaya-cart-drawer__stepper-btn"
                      data-action="plus"
                      data-key="{{ item.key }}"
                      data-qty="{{ item.quantity | plus: 1 }}"
                      aria-label="Increase quantity for {{ item.title | escape }}"
                    >
                      {% render 'icons', name: 'plus', width: 10, height: 10 %}
                    </button>
                  </div>

                  <!-- Price -->
                  <div class="ishaya-cart-drawer__item-price">
                    {{ item.final_line_price | money }}
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <!-- Empty State -->
        <div class="ishaya-cart-drawer__empty" id="CartDrawerEmptyState">
          <div class="ishaya-cart-drawer__empty-icon" aria-hidden="true">
            {% render 'icons', name: 'cart', width: 36, height: 36 %}
          </div>
          <h3 class="ishaya-cart-drawer__empty-title">YOUR BAG IS EMPTY</h3>
          <p class="ishaya-cart-drawer__empty-desc">
            Explore our curated catalog of architectural silhouettes and heavyweight textiles.
          </p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary ishaya-cart-drawer__empty-btn" data-close-cart>
            <span>EXPLORE ARCHIVE</span>
            {% render 'icons', name: 'arrow-right', width: 14, height: 14 %}
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Drawer Footer / Summary (Visible when items > 0) -->
    <div
      class="ishaya-cart-drawer__footer{% if cart.item_count == 0 %} ishaya-cart-drawer__footer--hidden{% endif %}"
      id="CartDrawerFooter"
    >
      
       
<!-- ISHAYA Discount Code -->
<div class="ishaya-discount-box">
  <label for="IshayaDiscountCode">
    HAVE A DISCOUNT CODE?
  </label>

  <form id="IshayaDiscountForm">
    <input
      type="text"
      id="IshayaDiscountCode"
      placeholder="Enter discount code"
      autocomplete="off"
    >
    <button type="submit">APPLY</button>
  </form>

  <p id="IshayaDiscountMessage" aria-live="polite"></p>
    {% if cart.cart_level_discount_applications.size > 0 %}
  <div class="ishaya-applied-discount">
    {% for discount in cart.cart_level_discount_applications %}
      <span>{{ discount.title | escape }} Applied</span>
    {% endfor %}

    <button type="button" id="IshayaRemoveDiscount">
      REMOVE
    </button>
  </div>
{% endif %}
</div>

<style>
.ishaya-discount-box {
  margin: 14px 0 20px;
}

.ishaya-discount-box label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  margin-bottom: 10px;
}

#IshayaDiscountForm {
  display: flex;
  gap: 8px;
}

#IshayaDiscountCode {
  flex: 1;
  min-width: 0;
  border: 1px solid #ccc;
  border-radius: 8px;
  padding: 12px;
  font-size: 14px;
  background: transparent;
  color: inherit;
}

#IshayaDiscountForm button {
  border: 0;
  border-radius: 8px;
  background: #111;
  color: #fff;
  padding: 0 18px;
  font-weight: 700;
  cursor: pointer;
}

#IshayaDiscountMessage {
  font-size: 12px;
  margin-top: 8px;
}
.ishaya-applied-discount {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
  font-size: 12px;
  font-weight: 600;
}

#IshayaRemoveDiscount {
  border: 0;
  background: transparent;
  color: #c62828;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}
/* ISHAYA - Compact Premium Cart Footer */

.ishaya-discount-box {
  margin: 8px 0 10px !important;
}

.ishaya-discount-box label {
  font-size: 11px !important;
  letter-spacing: 0.6px !important;
  margin-bottom: 6px !important;
}

#IshayaDiscountForm {
  gap: 7px !important;
}

#IshayaDiscountCode {
  padding: 9px 11px !important;
  font-size: 13px !important;
  min-height: 40px !important;
}

#IshayaDiscountForm button {
  padding: 0 15px !important;
  font-size: 12px !important;
  min-height: 40px !important;
}

#IshayaDiscountMessage:empty {
  display: none !important;
}

#IshayaDiscountMessage {
  margin: 5px 0 0 !important;
  font-size: 11px !important;
}

.ishaya-applied-discount {
  margin-top: 6px !important;
}

.ishaya-cart-drawer__subtotal-row {
  margin-top: 5px !important;
  margin-bottom: 5px !important;
}

.ishaya-cart-drawer__tax-disclaimer {
  margin-top: 5px !important;
  margin-bottom: 8px !important;
  font-size: 11px !important;
}

/* Reduce spacing around order note */
.ishaya-cart-drawer__note-details {
  margin-bottom: 4px !important;
}
/* ISHAYA - Extra Compact Cart Footer */

.ishaya-cart-drawer__note-details {
  margin: 0 0 2px !important;
  padding: 0 !important;
}

.ishaya-cart-drawer__note-details > summary {
  padding-top: 5px !important;
  padding-bottom: 5px !important;
}

.ishaya-discount-box {
  margin: 4px 0 6px !important;
  padding: 0 !important;
}

.ishaya-discount-box label {
  margin-bottom: 5px !important;
}

#IshayaDiscountCode,
#IshayaDiscountForm button {
  min-height: 38px !important;
}

#IshayaDiscountMessage:empty {
  display: none !important;
  margin: 0 !important;
}

.ishaya-cart-drawer__subtotal-row {
  margin: 0 !important;
  padding: 5px 0 !important;
}

.ishaya-cart-drawer__tax-disclaimer {
  margin: 3px 0 7px !important;
}
/* ISHAYA - Compact Cart Drawer Footer */

/* Discount section */
.ishaya-discount-box {
  margin: 0 0 8px !important;
  padding: 0 !important;
}

.ishaya-discount-box label {
  margin-bottom: 6px !important;
}

#IshayaDiscountCode {
  min-height: 40px !important;
  padding: 9px 12px !important;
}

#IshayaDiscountForm button {
  min-height: 40px !important;
  padding: 0 16px !important;
}

/* Subtotal */
.ishaya-cart-drawer__subtotal-row {
  margin: 0 !important;
  padding: 5px 0 !important;
}

/* Tax information */
.ishaya-cart-drawer__tax-disclaimer {
  margin: 4px 0 10px !important;
  padding: 0 !important;
  line-height: 1.4 !important;
}

/* Checkout button */
.ishaya-cart-drawer__checkout-btn {
  min-height: 44px !important;
  height: 44px !important;
  padding: 0 18px !important;
  font-size: 12px !important;
  letter-spacing: 1.3px !important;
  line-height: 1 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

/* Footer links */
.ishaya-cart-drawer__checkout-btn + * {
  margin-top: 8px !important;
}
</style>
<!-- End ISHAYA Discount Code -->
      {% if cart.total_discount > 0 %}
  <div class="ishaya-cart-drawer__subtotal-row"
       style="color:#16803c; margin-bottom:10px;">
    <span class="ishaya-cart-drawer__subtotal-label">
      DISCOUNT
      {% for discount in cart.cart_level_discount_applications %}
        ({{ discount.title | escape }})
      {% endfor %}
    </span>

    <strong class="ishaya-cart-drawer__subtotal-val">
      -{{ cart.total_discount | money }}
    </strong>
  </div>
{% endif %}
      <!-- Subtotal -->
      <div class="ishaya-cart-drawer__subtotal-row">
        <span class="ishaya-cart-drawer__subtotal-label">SUBTOTAL</span>
        <strong class="ishaya-cart-drawer__subtotal-val" id="CartDrawerSubtotal">
          {{ cart.total_price | money }}
        </strong>
      </div>
      <p class="ishaya-cart-drawer__tax-disclaimer">
        Taxes and calculated shipping added at checkout.
      </p>

      <!-- Checkout Button -->
      <a
        href="/checkout"
        class="btn btn--primary ishaya-cart-drawer__checkout-btn"
        id="CartDrawerCheckoutBtn"
      >
        <span>CHECKOUT NOW</span>
        {% render 'icons', name: 'arrow-right', width: 14, height: 14 %}
      </a>

      <!-- View Cart Page Link -->
      <a href="{{ routes.cart_url }}" class="ishaya-cart-drawer__view-cart-link">
        View Full Bag Details
      </a>
    </div>
  </div>
</div>

<style>
  .ishaya-cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    justify-content: flex-end;
  }

  .ishaya-cart-drawer[hidden] {
    display: none;
  }

  .ishaya-cart-drawer__backdrop {
    position: fixed;
    inset: 0;
    background: var(--glass-scrim);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .ishaya-cart-drawer__panel {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 480px;
    height: 100%;
    background-color: var(--color-surface);
    border-left: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-floating);
    animation: cartSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes cartSlideIn {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  /* Header */
  .ishaya-cart-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .ishaya-cart-drawer__header-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ishaya-cart-drawer__title {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0;
    color: var(--color-foreground);
  }

  .ishaya-cart-drawer__count-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    background-color: var(--color-foreground);
    color: var(--color-background);
    border-radius: var(--radius-pill);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .ishaya-cart-drawer__count-badge--hidden {
    display: none;
  }

  .ishaya-cart-drawer__close-btn {
    background: transparent;
    border: none;
    color: var(--color-foreground);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem;
    border-radius: 50%;
    transition: background-color var(--transition-fast);
  }

  .ishaya-cart-drawer__close-btn:hover {
    background-color: var(--glass-bg-hover);
  }

  /* Free Shipping Calculator */
  .ishaya-cart-drawer__shipping-bar {
    padding: 1rem 1.5rem;
    background: var(--glass-bg);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ishaya-cart-drawer__shipping-message {
    font-size: 0.78rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .ishaya-cart-drawer__shipping-message strong {
    color: var(--color-foreground);
  }

  .ishaya-cart-drawer__shipping-unlocked {
    color: #4ade80;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .ishaya-cart-drawer__progress-track {
    width: 100%;
    height: 4px;
    background: var(--color-border);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .ishaya-cart-drawer__progress-fill {
    height: 100%;
    background: var(--color-foreground);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Body */
  .ishaya-cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
  }

  .ishaya-cart-drawer__items-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .ishaya-cart-drawer__item {
    display: flex;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .ishaya-cart-drawer__item-media {
    width: 80px;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-input);
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .ishaya-cart-drawer__item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ishaya-cart-drawer__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface);
  }

  .ishaya-cart-drawer__placeholder svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ishaya-cart-drawer__item-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .ishaya-cart-drawer__item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .ishaya-cart-drawer__item-title {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.3;
    margin: 0;
  }

  .ishaya-cart-drawer__item-link {
    color: var(--color-foreground);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .ishaya-cart-drawer__item-link:hover {
    color: var(--color-foreground);
    opacity: 0.85;
  }

  .ishaya-cart-drawer__remove-btn {
    background: transparent;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    padding: 0.2rem;
    transition: color var(--transition-fast);
  }

  .ishaya-cart-drawer__remove-btn:hover {
    color: #ef4444;
  }

  .ishaya-cart-drawer__item-variant {
    font-size: 0.72rem;
    color: var(--color-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 0.2rem;
  }

  .ishaya-cart-drawer__item-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.75rem;
  }

  .ishaya-cart-drawer__stepper {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 2px 4px;
  }

  .ishaya-cart-drawer__stepper-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    background: transparent;
    border: none;
    color: var(--color-foreground);
    cursor: pointer;
    border-radius: 50%;
    transition: background-color var(--transition-fast);
  }

  .ishaya-cart-drawer__stepper-btn:hover {
    background-color: var(--glass-bg-hover);
  }

  .ishaya-cart-drawer__stepper-qty {
    font-size: 0.78rem;
    font-weight: 700;
    min-width: 24px;
    text-align: center;
  }

  .ishaya-cart-drawer__item-price {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-foreground);
  }

  /* Empty State */
  .ishaya-cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    padding: 2rem 1rem;
  }

  .ishaya-cart-drawer__empty-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--glass-bg);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .ishaya-cart-drawer__empty-title {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .ishaya-cart-drawer__empty-desc {
    font-size: 0.85rem;
    color: var(--color-muted);
    line-height: 1.5;
    max-width: 280px;
    margin-bottom: 1.5rem;
  }

  .ishaya-cart-drawer__empty-btn {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
  }

  /* Footer */
  .ishaya-cart-drawer__footer {
    padding: 1.5rem;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .ishaya-cart-drawer__footer--hidden {
    display: none;
  }

  .ishaya-cart-drawer__note-details {
