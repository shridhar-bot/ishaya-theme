<script>
  // ISHAYA - Remove discount
document.addEventListener('click', async function(event) {
  if (event.target.id !== 'IshayaRemoveDiscount') return;

  const button = event.target;
  button.disabled = true;
  button.textContent = 'REMOVING...';

  try {
    const root = window.Shopify?.routes?.root || '/';

    const response = await fetch(root + 'cart/update.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({ discount: '' })
    });

    if (!response.ok) throw new Error('Failed to remove discount');

    await window.refreshCartDrawer();

  } catch (error) {
    button.disabled = false;
    button.textContent = 'REMOVE';
    alert('Could not remove discount. Please try again.');
  }
});
  (function() {
    const drawer = document.getElementById('CartDrawer');
    if (!drawer) return;

    window.openCartDrawer = function() {
      drawer.removeAttribute('hidden');
      document.body.classList.add('drawer-open');
    };

    window.closeCartDrawer = function() {
      drawer.setAttribute('hidden', '');
      document.body.classList.remove('drawer-open');
    };

    // Close on click backdrop or close button
    drawer.querySelectorAll('[data-close-cart]').forEach(function(el) {
      el.addEventListener('click', window.closeCartDrawer);
    });

    // Close on Escape
    document.addEventListener('keydown', function(evt) {
      if (evt.key === 'Escape' && !drawer.hasAttribute('hidden')) {
        window.closeCartDrawer();
      }
    });

    // Re-render the drawer from the server so line items, totals and the
    // free-shipping bar always match what Liquid would render on a full load.
    const sectionUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root
      ? window.Shopify.routes.root
      : '/') + '?sections=cart-drawer';

    function swapRegion(freshDoc, id) {
      const current = document.getElementById(id);
      const next = freshDoc.getElementById(id);
      if (!current || !next) return;
      current.innerHTML = next.innerHTML;
      current.className = next.className;
    }
    // ISHAYA - Apply discount without leaving cart drawer
document.addEventListener('submit', async function(event) {
  if (event.target.id !== 'IshayaDiscountForm') return;

  event.preventDefault();

  const form = event.target;
  const input = form.querySelector('#IshayaDiscountCode');
  const message = document.getElementById('IshayaDiscountMessage');
  const button = form.querySelector('button');

  const code = input.value.trim().toUpperCase();

  if (!code) {
    message.textContent = 'Please enter a discount code.';
    return;
  }

  button.disabled = true;
  message.textContent = 'Checking discount...';

  try {
    const response = await fetch(
      (window.Shopify?.routes?.root || '/') + 'cart/update.js',
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ discount: code })
      }
    );

    if (!response.ok) {
      throw new Error('Discount request failed');
    }

    const cart = await response.json();

    // Refresh totals using Shopify's cart data
    await window.refreshCartDrawer();

    const newInput = document.getElementById('IshayaDiscountCode');
    const newMessage = document.getElementById('IshayaDiscountMessage');

    if (newInput) newInput.value = code;

    if (newMessage) {
      newMessage.textContent =
        'Code submitted. Final discount eligibility is confirmed at checkout.';
    }

  } catch (error) {
    message.textContent =
      'Unable to check discount. Please try again.';
  } finally {
    button.disabled = false;
  }
});
    window.refreshCartDrawer = function() {
      return fetch(sectionUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function(res) { return res.json(); })
        .then(function(sections) {
          const markup = sections && sections['cart-drawer'];
          if (!markup) return;

          const fresh = new DOMParser().parseFromString(markup, 'text/html');

          // Keep an unsaved order note across the swap
          const currentNote = document.getElementById('CartDrawerOrderNote');
          const pendingNote = currentNote ? currentNote.value : null;

          swapRegion(fresh, 'CartDrawerShippingBar');
          swapRegion(fresh, 'CartDrawerBody');
          swapRegion(fresh, 'CartDrawerFooter');

          const restoredNote = document.getElementById('CartDrawerOrderNote');
          if (restoredNote && pendingNote !== null) restoredNote.value = pendingNote;

          // Count badges (drawer header + site header)
          const nextBadge = fresh.getElementById('CartDrawerCountBadge');
          const drawerBadge = document.getElementById('CartDrawerCountBadge');
          if (nextBadge && drawerBadge) {
            drawerBadge.textContent = nextBadge.textContent.trim();
            drawerBadge.className = nextBadge.className;
          }

          const headerBadge = document.getElementById('HeaderCartCount');
          if (headerBadge && nextBadge) {
            const count = parseInt(nextBadge.textContent.trim(), 10) || 0;
            headerBadge.textContent = count;
            if (count > 0) {
              headerBadge.classList.remove('zb-cart-count--hidden');
            } else {
              headerBadge.classList.add('zb-cart-count--hidden');
            }
          }
        })
        .catch(function(err) {
          console.error('Error refreshing cart drawer:', err);
        });
    };

    // Listen to quantity changes and removals inside drawer
    drawer.addEventListener('click', function(e) {
      const stepperBtn = e.target.closest('.ishaya-cart-drawer__stepper-btn');
      const removeBtn = e.target.closest('.ishaya-cart-drawer__remove-btn');

      if (stepperBtn) {
        const key = stepperBtn.getAttribute('data-key');
        const qty = parseInt(stepperBtn.getAttribute('data-qty'), 10);
        updateCartQuantity(key, qty);
      } else if (removeBtn) {
        const key = removeBtn.getAttribute('data-remove-line');
        updateCartQuantity(key, 0);
      }
    });

    function updateCartQuantity(key, qty) {
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: key, quantity: qty })
      })
      .then(function(res) { return res.json(); })
      .then(function() {
        window.refreshCartDrawer();
      })
      .catch(function(err) {
        console.error('Error changing cart quantity:', err);
      });
    }

    // Auto-save Order Note on blur (delegated so it survives drawer re-renders)
    // ISHAYA - Change cart size

let cartSizeUpdating = false;

drawer.addEventListener('change', async function(e) {
  const select = e.target.closest('[data-cart-size-change]');
  if (!select) return;

  const oldVariant = String(select.dataset.currentVariant);
  const newVariant = String(select.value);
  const oldKey = select.dataset.lineKey;

  if (oldVariant === newVariant) return;

  if (cartSizeUpdating) {
    select.value = oldVariant;
    return;
  }

  cartSizeUpdating = true;
  select.disabled = true;

  const checkoutBtn = drawer.querySelector('#CartDrawerCheckoutBtn');

  if (checkoutBtn) {
    checkoutBtn.style.pointerEvents = 'none';
    checkoutBtn.setAttribute('aria-disabled', 'true');
  }

  const request = async (url, body) => {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify(body)
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.description || data.message || 'Cart update failed');
    }

    return data;
  };

  let addedQuantity = 0;

  try {
    const cart = await fetch('/cart.js').then(r => r.json());
    const oldItem = cart.items.find(item => item.key === oldKey);

    if (!oldItem) throw new Error('Cart item not found');

    const quantity = oldItem.quantity;

    const addBody = {
      items: [{
        id: Number(newVariant),
        quantity: quantity,
        properties: oldItem.properties || {}
      }]
    };

    if (oldItem.selling_plan_allocation) {
      addBody.items[0].selling_plan =
        oldItem.selling_plan_allocation.selling_plan.id;
    }

    await request('/cart/add.js', addBody);
    addedQuantity = quantity;

    await request('/cart/change.js', {
      id: oldKey,
      quantity: 0
    });

    await window.refreshCartDrawer();

    document.dispatchEvent(new CustomEvent('ishaya:cart:updated'));

  } catch (error) {
    console.error('ISHAYA size change error:', error);

    if (addedQuantity > 0) {
      console.warn('New variant was added. Check cart before retrying.');
    }

    alert(
      'Size update could not be completed. Please check your shopping bag before trying again.'
    );

    await window.refreshCartDrawer();

  } finally {
    cartSizeUpdating = false;

    if (checkoutBtn) {
      checkoutBtn.style.pointerEvents = '';
      checkoutBtn.removeAttribute('aria-disabled');
    }
  }
});
    drawer.addEventListener('change', function(e) {
      const noteTextarea = e.target.closest('#CartDrawerOrderNote');
      if (!noteTextarea) return;
      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ note: noteTextarea.value })
      });
    });
  })();
</script>