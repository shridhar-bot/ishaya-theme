{% doc %}
  Renders a streetwear product card with secondary image hover swap, price formatting, badges, and quick-add actions.

  @param {product} product - The product object to render
  @param {boolean} [show_secondary_image] - Whether to show the second product image on hover
  @param {boolean} [show_vendor] - Whether to display the brand/vendor
  @param {boolean} [show_quick_add] - Whether to display quick add to bag button
  @param {string} [aspect_ratio] - Aspect ratio for the media container ('portrait', 'square', 'adapt')
  @param {string} [class] - Extra CSS classes for the card container

  @example
  {% render 'product-card', product: product, show_secondary_image: true %}
{% enddoc %}

{%- liquid
  assign card_product = product
  assign featured_image = card_product.featured_media.preview_image | default: card_product.featured_image
  assign second_image = card_product.media[1].preview_image | default: card_product.images[1]
  assign ratio = aspect_ratio | default: 'portrait'
  assign has_secondary = false
  if show_secondary_image != false and second_image != blank
    assign has_secondary = true
  endif

  assign is_sold_out = false
  if card_product.available == false
    assign is_sold_out = true
  endif

  assign on_sale = false
  if card_product.compare_at_price > card_product.price
    assign on_sale = true
  endif
-%}

<div class="ishaya-product-card {{ class }}{% if is_sold_out %} ishaya-product-card--sold-out{% endif %}">
  <!-- Card Media Container -->
  <div class="ishaya-product-card__media-wrapper ishaya-product-card__media-wrapper--{{ ratio }}">
    <a
      href="{{ card_product.url }}"
      class="ishaya-product-card__media-link"
      aria-label="{{ card_product.title | escape }}"
    >
      {%- if featured_image != blank -%}
        {{
          featured_image
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            class: 'ishaya-product-card__image ishaya-product-card__image--primary',
            alt: featured_image.alt | default: card_product.title | escape
        }}

        {%- if has_secondary -%}
          {{
            second_image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              class: 'ishaya-product-card__image ishaya-product-card__image--secondary',
              alt: second_image.alt | default: card_product.title | escape
          }}
        {%- endif -%}
      {%- else -%}
        <div class="ishaya-product-card__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </a>

    <!-- Badges -->
    <div class="ishaya-product-card__badges" aria-hidden="true">
      {%- if is_sold_out -%}
        <span class="ishaya-product-badge ishaya-product-badge--sold-out">Sold Out</span>
      {%- elsif on_sale -%}
        {%- assign savings = card_product.compare_at_price | minus: card_product.price | times: 100.0 | divided_by: card_product.compare_at_price | round -%}
        <span class="ishaya-product-badge ishaya-product-badge--sale">-{{ savings }}%</span>
      {%- endif -%}

      {%- if card_product.tags contains 'exclusive' or card_product.tags contains 'limited' -%}
        <span class="ishaya-product-badge ishaya-product-badge--limited">Limited</span>
      {%- elsif card_product.tags contains 'new' -%}
        <span class="ishaya-product-badge ishaya-product-badge--new">New</span>
      {%- endif -%}
    </div>

    <!-- Quick Add to Bag -->
    {%- if show_quick_add != false and is_sold_out == false -%}
      <div class="ishaya-product-card__quick-actions">
        {%- if card_product.has_only_default_variant -%}
          <form method="post" action="{{ routes.cart_add_url }}" class="ishaya-product-card__form" data-quick-add-form>
            <input type="hidden" name="id" value="{{ card_product.first_available_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button
              type="submit"
              class="ishaya-product-card__quick-btn btn"
              aria-label="Quick add {{ card_product.title | escape }} to bag"
            >
              {% render 'icons', name: 'cart', width: 14, height: 14 %}
              <span>Quick Add</span>
            </button>
          </form>
        {%- else -%}
          <a
            href="{{ card_product.url }}"
            class="ishaya-product-card__quick-btn btn"
            aria-label="Select options for {{ card_product.title | escape }}"
          >
            <span>Choose Size</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <!-- Card Info -->
  <div class="ishaya-product-card__info">
    {%- if show_vendor and card_product.vendor != blank -%}
      <span class="ishaya-product-card__vendor">{{ card_product.vendor }}</span>
    {%- endif -%}

    <h3 class="ishaya-product-card__title">
      <a href="{{ card_product.url }}" class="ishaya-product-card__title-link">
        {{ card_product.title }}
      </a>
    </h3>

    <div class="ishaya-product-card__price-row">
      <span class="ishaya-product-card__price{% if on_sale %} ishaya-product-card__price--sale{% endif %}">
        {{ card_product.price | money }}
      </span>

      {%- if on_sale -%}
        <s class="ishaya-product-card__compare-price">
          {{ card_product.compare_at_price | money }}
        </s>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ishaya-product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    transition: transform var(--transition-smooth);
  }

  .ishaya-product-card__media-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-surface);
    border-radius: var(--radius-input);
    border: 1px solid var(--color-border);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .ishaya-product-card:hover .ishaya-product-card__media-wrapper {
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  }

  /* Aspect Ratios */
  .ishaya-product-card__media-wrapper--portrait {
    aspect-ratio: 3 / 4;
  }
  .ishaya-product-card__media-wrapper--square {
    aspect-ratio: 1 / 1;
  }
  .ishaya-product-card__media-wrapper--adapt {
    aspect-ratio: auto;
  }

  .ishaya-product-card__media-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ishaya-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }

  .ishaya-product-card:hover .ishaya-product-card__image--primary {
    transform: scale(1.04);
  }

  .ishaya-product-card__image--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    z-index: 2;
  }

  .ishaya-product-card:hover .ishaya-product-card__image--secondary {
    opacity: 1;
    transform: scale(1.04);
  }

  .ishaya-product-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 280px;
    background: #18181b;
  }

  .ishaya-product-card__placeholder svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  /* Badges */
  .ishaya-product-card__badges {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    z-index: 3;
    gap: 6px;
  }

  .ishaya-product-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .ishaya-product-badge--sold-out {
    background: rgba(0, 0, 0, 0.85);
    color: #a1a1aa;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .ishaya-product-badge--sale {
    background: rgba(220, 38, 38, 0.85);
    color: #ffffff;
  }

  .ishaya-product-badge--limited {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .ishaya-product-badge--new {
    background: rgba(255, 255, 255, 0.95);
    color: #09090b;
  }

  /* Quick Actions */
  .ishaya-product-card__quick-actions {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--transition-smooth), transform var(--transition-smooth);
    z-index: 4;
  }

  .ishaya-product-card:hover .ishaya-product-card__quick-actions,
  .ishaya-product-card:focus-within .ishaya-product-card__quick-actions {
    opacity: 1;
    transform: translateY(0);
  }

  .ishaya-product-card__form {
    width: 100%;
  }

  .ishaya-product-card__quick-btn {
    width: 100%;
    min-height: 42px;
    background: rgba(9, 9, 11, 0.9);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  .ishaya-product-card__quick-btn:hover {
    background: #ffffff;
    color: #09090b;
    border-color: #ffffff;
  }

  /* Card Info */
  .ishaya-product-card__info {
    padding-top: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .ishaya-product-card__vendor {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ishaya-product-card__title {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
  }

  .ishaya-product-card__title-link {
    color: var(--color-foreground);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .ishaya-product-card__title-link:hover {
    color: #ffffff;
    opacity: 0.85;
  }

  .ishaya-product-card__price-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 500;
  }

  .ishaya-product-card__price {
    color: var(--color-foreground);
  }

  .ishaya-product-card__price--sale {
    color: #ef4444;
  }

  .ishaya-product-card__compare-price {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  /* Touch / Mobile specific adjustments */
  @media (hover: none) {
    .ishaya-product-card__quick-actions {
      opacity: 1;
      position: static;
      transform: none;
      margin-top: 0.5rem;
    }

    .ishaya-product-card__quick-btn {
      background: var(--glass-bg);
      border-color: var(--color-border);
      color: var(--color-foreground);
    }
  }
{% endstylesheet %}
