{% doc %}
  @prompt
    Make a Coming Soon section, I want to add background image and video option
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-coming-soon-{{ ai_gen_id }}{display:block;position:relative;isolation:isolate;overflow:hidden;width:{{ block.settings.desktop_width_percent }}%;min-height:{{ block.settings.min_height }}px;box-sizing:border-box;padding:clamp(48px,8vw,112px) clamp(24px,6vw,96px);background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};text-align:{{ block.settings.alignment }}}
.ai-coming-soon-{{ ai_gen_id }}__media,.ai-coming-soon-{{ ai_gen_id }}__shade{position:absolute;inset:0;width:100%;height:100%}.ai-coming-soon-{{ ai_gen_id }}__media{z-index:-2;object-fit:cover}.ai-coming-soon-{{ ai_gen_id }}__shade{z-index:-1;background:{{ block.settings.overlay_color }};opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}}.ai-coming-soon-{{ ai_gen_id }}__inner{position:relative;z-index:1;width:100%;max-width:760px;margin:0 auto}.ai-coming-soon-{{ ai_gen_id }}__eyebrow{margin:0 0 18px;color:{{ block.settings.accent_color }};font-size:12px;font-weight:700;letter-spacing:.18em;line-height:1.4;text-transform:uppercase}.ai-coming-soon-{{ ai_gen_id }}__heading{margin:0;color:{{ block.settings.text_color }};font-size:clamp(36px,7vw,{{ block.settings.heading_size }}px);font-weight:700;letter-spacing:-.04em;line-height:1.02}.ai-coming-soon-{{ ai_gen_id }}__message{max-width:590px;margin:24px auto 0;color:{{ block.settings.muted_color }};font-size:17px;line-height:1.65}.ai-coming-soon-{{ ai_gen_id }}__launch{display:inline-block;margin-top:28px;padding:10px 16px;border:1px solid {{ block.settings.border_color }};border-radius:999px;color:{{ block.settings.text_color }};font-size:13px;font-weight:600;letter-spacing:.06em}.ai-coming-soon-{{ ai_gen_id }}__form-wrap{max-width:520px;margin:36px auto 0}.ai-coming-soon-{{ ai_gen_id }}__form{display:flex;gap:10px}.ai-coming-soon-{{ ai_gen_id }}__input{min-width:0;flex:1;padding:15px 17px;border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.input_radius }}px;background:{{ block.settings.input_background }};color:{{ block.settings.text_color }};font:inherit;font-size:15px}.ai-coming-soon-{{ ai_gen_id }}__input::placeholder{color:{{ block.settings.muted_color }}}.ai-coming-soon-{{ ai_gen_id }}__button{flex:0 0 auto;padding:15px 22px;border:1px solid {{ block.settings.button_background }};border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }};cursor:pointer;font:inherit;font-size:15px;font-weight:700}.ai-coming-soon-{{ ai_gen_id }}__status{margin:14px 0 0;color:{{ block.settings.muted_color }};font-size:14px;line-height:1.5}.ai-coming-soon-{{ ai_gen_id }}__status--error{color:#fca5a5}@media screen and (max-width:749px){.ai-coming-soon-{{ ai_gen_id }}{width:100%}.ai-coming-soon-{{ ai_gen_id }}__form{flex-direction:column}.ai-coming-soon-{{ ai_gen_id }}__button{width:100%}}
{% endstyle %}
<div class="ai-coming-soon-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% if block.settings.background_type == 'image' and block.settings.background_image %}<img class="ai-coming-soon-{{ ai_gen_id }}__media" src="{{ block.settings.background_image | image_url: width: 2400 }}" alt="" loading="lazy" width="{{ block.settings.background_image.width }}" height="{{ block.settings.background_image.height }}">{% elsif block.settings.background_type == 'video' and block.settings.background_video_url != blank %}<video class="ai-coming-soon-{{ ai_gen_id }}__media" autoplay muted loop playsinline aria-hidden="true"><source src="{{ block.settings.background_video_url }}" type="video/mp4"></video>{% endif %}<div class="ai-coming-soon-{{ ai_gen_id }}__shade"></div><div class="ai-coming-soon-{{ ai_gen_id }}__inner">{% if block.settings.eyebrow != blank %}<p class="ai-coming-soon-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}<h2 class="ai-coming-soon-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% if block.settings.message != blank %}<div class="ai-coming-soon-{{ ai_gen_id }}__message">{{ block.settings.message }}</div>{% endif %}{% if block.settings.launch_text != blank %}<div class="ai-coming-soon-{{ ai_gen_id }}__launch">{{ block.settings.launch_text }}</div>{% endif %}{% if block.settings.show_signup %}<div class="ai-coming-soon-{{ ai_gen_id }}__form-wrap">{% form 'contact' %}<div class="ai-coming-soon-{{ ai_gen_id }}__form"><label class="visually-hidden" for="ai-coming-soon-email-{{ ai_gen_id }}">{{ block.settings.email_label }}</label><input id="ai-coming-soon-email-{{ ai_gen_id }}" class="ai-coming-soon-{{ ai_gen_id }}__input" type="email" name="contact[email]" placeholder="{{ block.settings.email_placeholder }}" autocomplete="email" required><button class="ai-coming-soon-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label }}</button></div>{% if form.errors %}<p class="ai-coming-soon-{{ ai_gen_id }}__status ai-coming-soon-{{ ai_gen_id }}__status--error">{{ form.errors.messages.email }}</p>{% elsif form.posted_successfully? %}<p class="ai-coming-soon-{{ ai_gen_id }}__status">{{ block.settings.success_message }}</p>{% endif %}{% endform %}</div>{% endif %}</div></div>
{% schema %}{"name":"Coming soon","tag":null,"class":"coming-soon-block","settings":[{"type":"header","content":"Background"},{"type":"select","id":"background_type","label":"Background type","options":[{"value":"color","label":"Color"},{"value":"image","label":"Image"},{"value":"video","label":"Video"}],"default":"color"},{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"url","id":"background_video_url","label":"Video URL"},{"type":"color","id":"background_color","label":"Background","default":"#09090b"},{"type":"color","id":"overlay_color","label":"Overlay","default":"#09090b"},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":100,"step":5,"unit":"%","default":45},{"type":"header","content":"Content"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A new chapter is coming"},{"type":"text","id":"heading","label":"Heading","default":"Coming soon"},{"type":"textarea","id":"message","label":"Message","default":"We are putting the finishing touches on something special. Join the list and be the first to know when we launch."},{"type":"text","id":"launch_text","label":"Launch note","default":"Launching soon"},{"type":"checkbox","id":"show_signup","label":"Show email signup","default":true},{"type":"text","id":"email_label","label":"Email label","default":"Email address"},{"type":"text","id":"email_placeholder","label":"Email placeholder","default":"Enter your email"},{"type":"text","id":"button_label","label":"Button label","default":"Notify me"},{"type":"text","id":"success_message","label":"Success message","default":"Thanks — you are on the list."},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"min_height","label":"Minimum height","min":300,"max":900,"step":50,"unit":"px","default":500},{"type":"range","id":"heading_size","label":"Heading size","min":48,"max":120,"step":4,"unit":"px","default":80},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},{"type":"header","content":"Colors"},{"type":"color","id":"text_color","label":"Text","default":"#f4f4f5"},{"type":"color","id":"muted_color","label":"Muted text","default":"#a1a1aa"},{"type":"color","id":"accent_color","label":"Accent","default":"#ffffff"},{"type":"color","id":"border_color","label":"Border","default":"#3f3f46"},{"type":"color","id":"input_background","label":"Input background","default":"#121215"},{"type":"color","id":"button_background","label":"Button background","default":"#f4f4f5"},{"type":"color","id":"button_text_color","label":"Button text","default":"#09090b"},{"type":"range","id":"input_radius","label":"Input radius","min":0,"max":24,"step":2,"unit":"px","default":6},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":40,"step":2,"unit":"px","default":24}],"presets":[{"name":"Coming soon"}]}{% endschema %}