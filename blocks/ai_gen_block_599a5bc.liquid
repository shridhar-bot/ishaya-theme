{% doc %}
  @prompt
    Edit the Contact Support Form section to make all text content (such as Email Studio, Hours, Archive, Exchange, and any other labels or headings) customizable through the theme editor settings, so the merchant can change them without editing code., make it more creative , Support Information should separate box design and creative design , Remove number from the support information make a box design is in glassy
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture ai_form_id %}GlassSupport-{{ ai_gen_id }}{% endcapture %}
{% style %}
.ai-glass-support-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;box-sizing:border-box;padding:clamp(24px,5vw,72px);color:{{ block.settings.text_color }};background:{{ block.settings.background_color }};font-family:inherit}
.ai-glass-support-{{ ai_gen_id }}__layout{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,.78fr);gap:clamp(32px,7vw,88px);align-items:start}
.ai-glass-support-{{ ai_gen_id }}__eyebrow{display:inline-flex;align-items:center;gap:10px;margin:0 0 18px;color:{{ block.settings.accent_color }};font-size:12px;letter-spacing:.16em;text-transform:uppercase}.ai-glass-support-{{ ai_gen_id }}__eyebrow:before{content:"";width:26px;height:1px;background:currentColor}
.ai-glass-support-{{ ai_gen_id }}__title{max-width:620px;margin:0;font-size:clamp(34px,5vw,64px);line-height:1.04;letter-spacing:-.045em;color:{{ block.settings.text_color }}}.ai-glass-support-{{ ai_gen_id }}__intro{max-width:540px;margin:20px 0 30px;color:{{ block.settings.muted_color }};line-height:1.7}
.ai-glass-support-{{ ai_gen_id }}__form{display:grid;grid-template-columns:1fr 1fr;gap:18px}.ai-glass-support-{{ ai_gen_id }}__field{display:grid;gap:8px}.ai-glass-support-{{ ai_gen_id }}__field--wide{grid-column:1/-1}.ai-glass-support-{{ ai_gen_id }}__label{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:{{ block.settings.text_color }}}
.ai-glass-support-{{ ai_gen_id }}__input,.ai-glass-support-{{ ai_gen_id }}__textarea{width:100%;box-sizing:border-box;padding:13px 14px;background:{{ block.settings.input_background }};color:{{ block.settings.text_color }};border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.corner_radius }}px;font:inherit}.ai-glass-support-{{ ai_gen_id }}__textarea{min-height:128px;resize:vertical}.ai-glass-support-{{ ai_gen_id }}__input::placeholder,.ai-glass-support-{{ ai_gen_id }}__textarea::placeholder{color:{{ block.settings.muted_color }}}
.ai-glass-support-{{ ai_gen_id }}__input:focus-visible,.ai-glass-support-{{ ai_gen_id }}__textarea:focus-visible,.ai-glass-support-{{ ai_gen_id }}__button:focus-visible{outline:2px solid {{ block.settings.accent_color }};outline-offset:3px}.ai-glass-support-{{ ai_gen_id }}__button{grid-column:1/-1;justify-self:start;display:inline-flex;align-items:center;gap:18px;padding:14px 21px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text }};border:1px solid {{ block.settings.button_background }};border-radius:{{ block.settings.corner_radius }}px;font:inherit;cursor:pointer}.ai-glass-support-{{ ai_gen_id }}__button:hover{opacity:.82}.ai-glass-support-{{ ai_gen_id }}__button svg{width:16px;height:16px}
.ai-glass-support-{{ ai_gen_id }}__notice{grid-column:1/-1;padding:12px 14px;border:1px solid {{ block.settings.border_color }};color:{{ block.settings.text_color }}}
.ai-glass-support-{{ ai_gen_id }}__side{display:grid;gap:14px}.ai-glass-support-{{ ai_gen_id }}__side-heading{margin:0 0 6px;font-size:clamp(22px,2.5vw,30px);letter-spacing:-.02em;color:{{ block.settings.text_color }}}
.ai-glass-support-{{ ai_gen_id }}__item{position:relative;display:flex;align-items:flex-start;gap:16px;padding:22px;background:{{ block.settings.card_background }};background:color-mix(in srgb, {{ block.settings.card_background }} 76%, transparent);border:1px solid {{ block.settings.card_border }};border-radius:{{ block.settings.corner_radius | plus: 8 }}px;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);box-shadow:0 10px 34px rgba(0,0,0,.12);transition:transform .2s ease,border-color .2s ease}.ai-glass-support-{{ ai_gen_id }}__item:hover{transform:translateY(-3px);border-color:{{ block.settings.accent_color }}}
{% comment %}.ai-glass-support-{{ ai_gen_id }}__icon{flex:0 0 38px;width:38px;height:38px;display:flex;align-items:center;justify-content:center;border:1px solid {{ block.settings.card_border }};border-radius:50%;color:{{ block.settings.accent_color }};background:{{ block.settings.icon_background }}}.ai-glass-support-{{ ai_gen_id }}__icon svg{width:17px;height:17px}.ai-glass-support-{{ ai_gen_id }}__item-title{margin:2px 0 8px;color:{{ block.settings.text_color }};font-size:14px;letter-spacing:.1em;text-transform:uppercase}.ai-glass-support-{{ ai_gen_id }}__item-copy{color:{{ block.settings.muted_color }};font-size:14px;line-height:1.65}.ai-glass-support-{{ ai_gen_id }}__item-copy p{margin:0 0 8px}.ai-glass-support-{{ ai_gen_id }}__item-copy a{color:{{ block.settings.text_color }};text-underline-offset:3px}
{% endcomment %}
@media(max-width:749px){.ai-glass-support-{{ ai_gen_id }}__layout{grid-template-columns:1fr;gap:34px}.ai-glass-support-{{ ai_gen_id }}__form{grid-template-columns:1fr}.ai-glass-support-{{ ai_gen_id }}__field--wide,.ai-glass-support-{{ ai_gen_id }}__button,.ai-glass-support-{{ ai_gen_id }}__notice{grid-column:1}}
{% endstyle %}
<div class="ai-glass-support-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-glass-support-{{ ai_gen_id }}__layout"><div><p class="ai-glass-support-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p><h2 class="ai-glass-support-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2><div class="ai-glass-support-{{ ai_gen_id }}__intro">{{ block.settings.intro }}</div>
{% form 'contact', id: ai_form_id %}{% if form.posted_successfully? %}<p class="ai-glass-support-{{ ai_gen_id }}__notice" role="status">{{ block.settings.success_message | escape }}</p>{% endif %}{% if form.errors %}<div class="ai-glass-support-{{ ai_gen_id }}__notice" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<div class="ai-glass-support-{{ ai_gen_id }}__form"><div class="ai-glass-support-{{ ai_gen_id }}__field"><label class="ai-glass-support-{{ ai_gen_id }}__label" for="SupportName-{{ ai_gen_id }}">{{ block.settings.name_label | escape }}</label><input class="ai-glass-support-{{ ai_gen_id }}__input" id="SupportName-{{ ai_gen_id }}" name="contact[name]" type="text" autocomplete="name" placeholder="{{ block.settings.name_placeholder | escape }}" value="{{ form.name | escape }}"></div><div class="ai-glass-support-{{ ai_gen_id }}__field"><label class="ai-glass-support-{{ ai_gen_id }}__label" for="SupportEmail-{{ ai_gen_id }}">{{ block.settings.email_label | escape }}</label><input class="ai-glass-support-{{ ai_gen_id }}__input" id="SupportEmail-{{ ai_gen_id }}" name="contact[email]" type="email" autocomplete="email" placeholder="{{ block.settings.email_placeholder | escape }}" value="{{ form.email | escape }}" required aria-required="true"></div><div class="ai-glass-support-{{ ai_gen_id }}__field ai-glass-support-{{ ai_gen_id }}__field--wide"><label class="ai-glass-support-{{ ai_gen_id }}__label" for="SupportSubject-{{ ai_gen_id }}">{{ block.settings.subject_label | escape }}</label><input class="ai-glass-support-{{ ai_gen_id }}__input" id="SupportSubject-{{ ai_gen_id }}" name="contact[subject]" type="text" placeholder="{{ block.settings.subject_placeholder | escape }}" value="{{ form.subject | escape }}"></div><div class="ai-glass-support-{{ ai_gen_id }}__field ai-glass-support-{{ ai_gen_id }}__field--wide"><label class="ai-glass-support-{{ ai_gen_id }}__label" for="SupportMessage-{{ ai_gen_id }}">{{ block.settings.message_label | escape }}</label><textarea class="ai-glass-support-{{ ai_gen_id }}__textarea" id="SupportMessage-{{ ai_gen_id }}" name="contact[body]" placeholder="{{ block.settings.message_placeholder | escape }}" required aria-required="true">{{ form.body | escape }}</textarea></div><button class="ai-glass-support-{{ ai_gen_id }}__button" type="submit">{{ block.settings.submit_label | escape }}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div>{% endform %}</div>
<aside class="ai-glass-support-{{ ai_gen_id }}__side" aria-label="{{ block.settings.details_accessible_label | escape }}"><h3 class="ai-glass-support-{{ ai_gen_id }}__side-heading">{{ block.settings.details_heading | escape }}</h3>{% for i in (1..4) %}{% assign heading_key = 'detail_' | append: i | append: '_heading' %}{% assign content_key = 'detail_' | append: i | append: '_content' %}{% assign detail_heading = block.settings[heading_key] %}{% assign detail_content = block.settings[content_key] %}{% if detail_heading != blank or detail_content != blank %}<section class="ai-glass-support-{{ ai_gen_id }}__item"><span class="ai-glass-support-{{ ai_gen_id }}__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 6.5h16v11H4zM4 7l8 6 8-6" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg></span><div><h4 class="ai-glass-support-{{ ai_gen_id }}__item-title">{{ detail_heading | escape }}</h4><div class="ai-glass-support-{{ ai_gen_id }}__item-copy">{{ detail_content }}</div></div></section>{% endif %}{% endfor %}</aside></div></div>
{% schema %}{"name":"Glass support form","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Main content"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Here for you"},{"type":"text","id":"heading","label":"Heading","default":"Let’s find the right answer."},{"type":"richtext","id":"intro","label":"Introduction","default":"<p>Whether you have a question or need a little guidance, send us a note and our team will be in touch.</p>"},{"type":"text","id":"name_label","label":"Name label","default":"Name"},{"type":"text","id":"name_placeholder","label":"Name placeholder","default":"Your name"},{"type":"text","id":"email_label","label":"Email label","default":"Email address"},{"type":"text","id":"email_placeholder","label":"Email placeholder","default":"you@example.com"},{"type":"text","id":"subject_label","label":"Subject label","default":"What can we help with?"},{"type":"text","id":"subject_placeholder","label":"Subject placeholder","default":"A few words about your question"},{"type":"text","id":"message_label","label":"Message label","default":"Your message"},{"type":"text","id":"message_placeholder","label":"Message placeholder","default":"Tell us a little more…"},{"type":"text","id":"submit_label","label":"Submit button","default":"Send your message"},{"type":"text","id":"success_message","label":"Success message","default":"Thank you. Your message has been sent."},{"type":"header","content":"Support information"},{"type":"text","id":"details_accessible_label","label":"Accessible label","default":"Support information"},{"type":"text","id":"details_heading","label":"Panel heading","default":"A little more help"},{"type":"text","id":"detail_1_heading","label":"Detail 1 heading","default":"Email Studio"},{"type":"richtext","id":"detail_1_content","label":"Detail 1 content","default":"<p>Reach our team for personal support and product guidance.</p>"},{"type":"text","id":"detail_2_heading","label":"Detail 2 heading","default":"Hours"},{"type":"richtext","id":"detail_2_content","label":"Detail 2 content","default":"<p>We’re available Monday to Friday during business hours.</p>"},{"type":"text","id":"detail_3_heading","label":"Detail 3 heading","default":"Archive"},{"type":"richtext","id":"detail_3_content","label":"Detail 3 content","default":"<p>Find details about earlier collections and pieces.</p>"},{"type":"text","id":"detail_4_heading","label":"Detail 4 heading","default":"Exchange"},{"type":"richtext","id":"detail_4_content","label":"Detail 4 content","default":"<p>Get in touch and we’ll guide you through your options.</p>"},{"type":"header","content":"Style"},{"type":"range","id":"corner_radius","label":"Corner radius","min":0,"max":20,"step":1,"unit":"px","default":6},{"type":"color","id":"background_color","label":"Background","default":"#09090B"},{"type":"color","id":"input_background","label":"Input background","default":"#09090B"},{"type":"color","id":"card_background","label":"Card background","default":"#27272A"},{"type":"color","id":"icon_background","label":"Icon background","default":"#18181B"},{"type":"color","id":"text_color","label":"Text","default":"#F4F4F5"},{"type":"color","id":"muted_color","label":"Secondary text","default":"#A1A1AA"},{"type":"color","id":"accent_color","label":"Accent","default":"#FFFFFF"},{"type":"color","id":"border_color","label":"Input borders","default":"#52525B"},{"type":"color","id":"card_border","label":"Card borders","default":"#71717A"},{"type":"color","id":"button_background","label":"Button background","default":"#FFFFFF"},{"type":"color","id":"button_text","label":"Button text","default":"#09090B"}],"presets":[{"name":"Glass support form"}],"tag":null,"class":"glass-support-form"}{% endschema %}