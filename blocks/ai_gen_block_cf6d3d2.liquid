{% doc %}
  @prompt
    make coming soon section and also sperate section for add image and add video , to add different video and photo for responsive, can not able to upload video format in both responsive media
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-coming-soon-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
    min-height: {{ block.settings.min_height }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-coming-soon-{{ ai_gen_id }}__media,
  .ai-coming-soon-{{ ai_gen_id }}__media-item {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-coming-soon-{{ ai_gen_id }}__media-item {
    object-fit: cover;
  }

  .ai-coming-soon-{{ ai_gen_id }}__media--mobile {
    display: none;
  }

  .ai-coming-soon-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .ai-coming-soon-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    min-height: {{ block.settings.min_height }}px;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.content_alignment }};
    justify-content: center;
    padding: 48px 24px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-coming-soon-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 12px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ai-coming-soon-{{ ai_gen_id }}__heading {
    max-width: 720px;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
    letter-spacing: {{ settings.heading_letter_spacing }}px;
    text-transform: {% if settings.heading_uppercase %}uppercase{% else %}none{% endif %};
  }

  .ai-coming-soon-{{ ai_gen_id }}__message {
    max-width: 560px;
    margin: 18px 0 0;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-coming-soon-{{ ai_gen_id }}__date {
    margin: 20px 0 0;
    color: {{ block.settings.accent_color }};
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .ai-coming-soon-{{ ai_gen_id }}__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.muted_color }};
  }

  .ai-coming-soon-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    max-width: 420px;
    max-height: 420px;
    opacity: 0.35;
  }

  @media screen and (max-width: 749px) {
    .ai-coming-soon-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_min_height }}px;
    }

    .ai-coming-soon-{{ ai_gen_id }}__content {
      min-height: {{ block.settings.mobile_min_height }}px;
      padding: 36px 20px;
    }

    .ai-coming-soon-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-coming-soon-{{ ai_gen_id }}__media--desktop {
      display: none;
    }

    .ai-coming-soon-{{ ai_gen_id }}__media--mobile {
      display: block;
    }
  }
{% endstyle %}

<coming-soon-{{ ai_gen_id }} class="ai-coming-soon-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-coming-soon-{{ ai_gen_id }}__media ai-coming-soon-{{ ai_gen_id }}__media--desktop">
    {% if block.settings.desktop_media_type == 'video' and block.settings.desktop_video != blank %}
      {{ block.settings.desktop_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'ai-coming-soon-' | append: ai_gen_id | append: '__media-item' }}
    {% elsif block.settings.desktop_image != blank %}
      {{ block.settings.desktop_image | image_url: width: 2400 | image_tag: loading: 'lazy', class: 'ai-coming-soon-' | append: ai_gen_id | append: '__media-item', alt: block.settings.desktop_image.alt | escape }}
    {% else %}
      <div class="ai-coming-soon-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
    {% endif %}
  </div>

  <div class="ai-coming-soon-{{ ai_gen_id }}__media ai-coming-soon-{{ ai_gen_id }}__media--mobile">
    {% if block.settings.mobile_media_type == 'video' and block.settings.mobile_video != blank %}
      {{ block.settings.mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'ai-coming-soon-' | append: ai_gen_id | append: '__media-item' }}
    {% elsif block.settings.mobile_image != blank %}
      {{ block.settings.mobile_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'ai-coming-soon-' | append: ai_gen_id | append: '__media-item', alt: block.settings.mobile_image.alt | escape }}
    {% elsif block.settings.desktop_image != blank %}
      {{ block.settings.desktop_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'ai-coming-soon-' | append: ai_gen_id | append: '__media-item', alt: block.settings.desktop_image.alt | escape }}
    {% else %}
      <div class="ai-coming-soon-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
    {% endif %}
  </div>

  <div class="ai-coming-soon-{{ ai_gen_id }}__overlay"></div>
  <div class="ai-coming-soon-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}<p class="ai-coming-soon-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
    <h2 class="ai-coming-soon-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
    {% if block.settings.message != blank %}<p class="ai-coming-soon-{{ ai_gen_id }}__message">{{ block.settings.message }}</p>{% endif %}
    {% if block.settings.launch_text != blank %}<p class="ai-coming-soon-{{ ai_gen_id }}__date">{{ block.settings.launch_text }}</p>{% endif %}
  </div>
</coming-soon-{{ ai_gen_id }}>

<script>
  (function() {
    if (!customElements.get('coming-soon-{{ ai_gen_id }}')) {
      customElements.define('coming-soon-{{ ai_gen_id }}', class extends HTMLElement {
        connectedCallback() {
          this.querySelectorAll('video').forEach((video) => {
            video.play().catch(() => {});
          });
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Coming soon media",
  "settings": [
    { "type": "header", "content": "Coming soon content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Coming soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something beautiful is on the way" },
    { "type": "textarea", "id": "message", "label": "Message", "default": "We are preparing something special for you. Please check back soon." },
    { "type": "text", "id": "launch_text", "label": "Launch text", "default": "Launching soon" },
    { "type": "header", "content": "Desktop media" },
    { "type": "select", "id": "desktop_media_type", "label": "Media type", "options": [{ "value": "image", "label": "Image" }, { "value": "video", "label": "Video" }], "default": "image" },
    { "type": "image_picker", "id": "desktop_image", "label": "Image" },
    { "type": "video", "id": "desktop_video", "label": "Video" },
    { "type": "header", "content": "Mobile media" },
    { "type": "select", "id": "mobile_media_type", "label": "Media type", "options": [{ "value": "image", "label": "Image" }, { "value": "video", "label": "Video" }], "default": "image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Image" },
    { "type": "video", "id": "mobile_video", "label": "Video" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "min_height", "label": "Desktop height", "min": 300, "max": 900, "step": 50, "unit": "px", "default": 600 },
    { "type": "range", "id": "mobile_min_height", "label": "Mobile height", "min": 260, "max": 700, "step": 20, "unit": "px", "default": 480 },
    { "type": "select", "id": "content_alignment", "label": "Content position", "options": [{ "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Right" }], "default": "center" },
    { "type": "radio", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 22, "max": 56, "step": 2, "unit": "px", "default": 34 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#09090b" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f4f4f5" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ffffff" },
    { "type": "color", "id": "muted_color", "label": "Muted", "default": "#71717a" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "#09090b" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 35 }
  ],
  "presets": [{ "name": "Coming soon media" }],
  "tag": null,
  "class": "coming-soon-media-block"
}
{% endschema %}