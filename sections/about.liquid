{% comment %}
  ISHAYA Brand Story & About Page Section
  Architectural brand manifesto detailing design philosophy,
  textile specifications, and studio standards.
{% endcomment %}

<section
  id="AboutSection-{{ section.id }}"
  class="ishaya-about full-width"
  aria-label="{{ page.title | default: 'About Ishaya' | escape }}"
>
  <!-- Hero Section -->
  <div class="ishaya-about__hero">
    <div class="page-container ishaya-about__hero-container">
      <div class="ishaya-about__hero-content">
        <span class="ishaya-about__badge glass-panel">
          <span class="ishaya-about__badge-dot" aria-hidden="true"></span>
          {{ section.settings.badge | default: 'ISHAYA ATELIER // ARCHIVAL MANIFESTO' }}
        </span>

        <h1 class="ishaya-about__title">
          {{ section.settings.title | default: 'BORN FROM RAW INDUSTRIAL GEOMETRY' }}
        </h1>

        <p class="ishaya-about__lead">
          {{ section.settings.lead | default: 'Meticulously engineered streetwear developed at the intersection of utilitarian functionality, structural proportion, and heavyweight custom-milled textiles.' }}
        </p>
      </div>
    </div>
  </div>

  <!-- 3-Pillar Philosophy Grid -->
  <div class="ishaya-about__pillars-section">
    <div class="page-container">
      <div class="ishaya-about__section-header">
        <span class="ishaya-about__section-tag">FOUNDATIONAL PILLARS</span>
        <h2 class="ishaya-about__section-title">THE TRIAD OF UTILITY</h2>
      </div>

      <div class="ishaya-about__pillars-grid">
        <!-- Pillar 1 -->
        <div class="ishaya-about__pillar-card glass-panel">
          <span class="ishaya-about__pillar-num">01 // PROPORTION</span>
          <h3 class="ishaya-about__pillar-heading">GEOMETRIC SILHOUETTES</h3>
          <p class="ishaya-about__pillar-desc">
            Articulated dropped shoulders, boxy cropped lengths, and modular volumes. Every seam is calculated to maintain structural presence whether standing in stillness or in urban movement.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="ishaya-about__pillar-card glass-panel">
          <span class="ishaya-about__pillar-num">02 // WEIGHT</span>
          <h3 class="ishaya-about__pillar-heading">TEXTILE DENSITY</h3>
          <p class="ishaya-about__pillar-desc">
            Uncompromising yarn weights. We source and custom-mill 500GSM organic French terry, high-twist canvas, and technical weatherproof membranes built for decades of rotation.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="ishaya-about__pillar-card glass-panel">
          <span class="ishaya-about__pillar-num">03 // DISCIPLINE</span>
          <h3 class="ishaya-about__pillar-heading">ZERO RE-RUNS</h3>
          <p class="ishaya-about__pillar-desc">
            Numbered, finite editions. When an iteration sells out, the pattern is permanently archived. We prioritize design evolution over mass commercial saturation.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Full-Width Quote Break -->
  <div class="ishaya-about__quote-banner full-width">
    <div class="ishaya-about__quote-overlay" aria-hidden="true"></div>
    <div class="page-container ishaya-about__quote-container">
      <blockquote class="ishaya-about__quote">
        "WE DO NOT MANUFACTURE EPHEMERAL TRENDS. WE ASSEMBLE LASTING ARTIFACTS DESIGNED FOR URBAN RESISTANCE."
      </blockquote>
      <cite class="ishaya-about__quote-author">— ISHAYA DESIGN COLLECTIVE, TOKYO & LONDON</cite>
    </div>
  </div>

  <!-- Studio & Production Standards Grid -->
  <div class="ishaya-about__specs-section">
    <div class="page-container">
      <div class="ishaya-about__specs-grid glass-panel">
        <div class="ishaya-about__spec-cell">
          <span class="ishaya-about__spec-idx">SPEC 01</span>
          <strong class="ishaya-about__spec-title">ORIGIN</strong>
          <span class="ishaya-about__spec-desc">Milled in Portugal & Japan by certified heritage knitters.</span>
        </div>
        <div class="ishaya-about__spec-cell">
          <span class="ishaya-about__spec-idx">SPEC 02</span>
          <strong class="ishaya-about__spec-title">DENSITY</strong>
          <span class="ishaya-about__spec-desc">500GSM+ pre-shrunk cotton terry with zero synthetic fillers.</span>
        </div>
        <div class="ishaya-about__spec-cell">
          <span class="ishaya-about__spec-idx">SPEC 03</span>
          <strong class="ishaya-about__spec-title">HARDWARE</strong>
          <span class="ishaya-about__spec-desc">Matte black double-pull industrial zippers and reinforced bar-tacks.</span>
        </div>
        <div class="ishaya-about__spec-cell">
          <span class="ishaya-about__spec-idx">SPEC 04</span>
          <strong class="ishaya-about__spec-title">PACKAGING</strong>
          <span class="ishaya-about__spec-desc">100% recycled archival presentation boxes with numbered seals.</span>
        </div>
      </div>

      <div class="ishaya-about__actions">
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary ishaya-about__btn">
          <span>EXPLORE THE CURRENT ARCHIVE</span>
          {% render 'icons', name: 'arrow-right', width: 14, height: 14 %}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ishaya-about {
    background-color: var(--color-background);
    color: var(--color-foreground);
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }

  /* Hero */
  .ishaya-about__hero {
    padding-top: clamp(4rem, 8vw, 8rem);
    padding-bottom: clamp(3rem, 6vw, 6rem);
    border-bottom: 1px solid var(--color-border);
    background: radial-gradient(circle at 50% 0%, #151518 0%, var(--color-background) 75%);
  }

  .ishaya-about__hero-content {
    max-width: 900px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .ishaya-about__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    width: fit-content;
  }

  .ishaya-about__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-foreground);
  }

  .ishaya-about__title {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .ishaya-about__lead {
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    color: #a1a1aa;
    line-height: 1.6;
    max-width: 780px;
    margin: 0;
    text-wrap: balance;
  }

  /* Pillars */
  .ishaya-about__pillars-section {
    padding-top: clamp(4rem, 7vw, 6.5rem);
    padding-bottom: clamp(4rem, 7vw, 6.5rem);
  }

  .ishaya-about__section-header {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ishaya-about__section-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ishaya-about__section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .ishaya-about__pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .ishaya-about__pillar-card {
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    border-radius: var(--radius-input);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ishaya-about__pillar-num {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-muted);
  }

  .ishaya-about__pillar-heading {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0;
  }

  .ishaya-about__pillar-desc {
    font-size: 0.9rem;
    color: #a1a1aa;
    line-height: 1.6;
    margin: 0;
  }

  /* Quote Break */
  .ishaya-about__quote-banner {
    position: relative;
    padding: clamp(5rem, 10vw, 9rem) 0;
    background-color: #0c0c0f;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    text-align: center;
  }

  .ishaya-about__quote-overlay {
    position: absolute;
    inset: 0;
    background-size: 60px 60px;
    background-image: linear-gradient(to right, var(--glass-border) 1px, transparent 1px),
                      linear-gradient(to bottom, var(--glass-border) 1px, transparent 1px);
    pointer-events: none;
  }

  .ishaya-about__quote-container {
    position: relative;
    z-index: 2;
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .ishaya-about__quote {
    font-size: clamp(1.75rem, 4.5vw, 3.25rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1.15;
    text-transform: uppercase;
    margin: 0;
    text-wrap: balance;
  }

  .ishaya-about__quote-author {
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Specs Section */
  .ishaya-about__specs-section {
    padding-top: clamp(4rem, 7vw, 6.5rem);
  }

  .ishaya-about__specs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-radius: var(--radius-input);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .ishaya-about__spec-cell {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-right: 1px solid var(--color-border);
  }

  .ishaya-about__spec-cell:last-child {
    border-right: none;
  }

  .ishaya-about__spec-idx {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-muted);
  }

  .ishaya-about__spec-title {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ishaya-about__spec-desc {
    font-size: 0.82rem;
    color: #a1a1aa;
    line-height: 1.5;
  }

  .ishaya-about__actions {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
  }

  .ishaya-about__btn {
    min-height: 52px;
    padding: 0 2.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    border-radius: var(--radius-pill);
  }

  @media (max-width: 1024px) {
    .ishaya-about__pillars-grid {
      grid-template-columns: 1fr;
    }

    .ishaya-about__specs-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ishaya-about__spec-cell:nth-child(2) {
      border-right: none;
    }

    .ishaya-about__spec-cell:nth-child(-n+2) {
      border-bottom: 1px solid var(--color-border);
    }
  }

  @media (max-width: 640px) {
    .ishaya-about__specs-grid {
      grid-template-columns: 1fr;
    }

    .ishaya-about__spec-cell {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .ishaya-about__spec-cell:last-child {
      border-bottom: none;
    }
  }
</style>

{% schema %}
{
  "name": "About / Brand Story",
  "tag": "section",
  "class": "section-about",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Top Badge",
      "default": "ISHAYA ATELIER // ARCHIVAL MANIFESTO"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Heading",
      "default": "BORN FROM RAW INDUSTRIAL GEOMETRY"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead Statement",
      "default": "Meticulously engineered streetwear developed at the intersection of utilitarian functionality, structural proportion, and heavyweight custom-milled textiles."
    }
  ]
}
{% endschema %}
