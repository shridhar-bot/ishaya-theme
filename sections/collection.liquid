{% comment %}
  ISHAYA Collection Page
  Architectural streetwear collection catalog featuring native Shopify Storefront
  filtering, sorting controls, active filter chips, responsive grid density,
  and accessible pagination.
{% endcomment %}

{%- liquid
  assign products_limit = section.settings.products_per_page | default: 16
  assign cols_desktop = section.settings.columns_desktop | default: 4
  assign has_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign has_filters = true
  endif
-%}

{% paginate collection.products by products_limit %}
  <section
    id="CollectionSection-{{ section.id }}"
    class="ishaya-collection full-width"
    aria-label="{{ collection.title | escape }}"
  >
    <!-- Breadcrumbs -->
    <nav class="page-container ishaya-collection__breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="ishaya-collection__crumb">Home</a>
      <span class="ishaya-collection__crumb-sep" aria-hidden="true">/</span>
      <a href="{{ routes.collections_url }}" class="ishaya-collection__crumb">Collections</a>
      <span class="ishaya-collection__crumb-sep" aria-hidden="true">/</span>
      <span class="ishaya-collection__crumb ishaya-collection__crumb--current" aria-current="page">
        {{- collection.title -}}
      </span>
    </nav>

    <!-- Collection Hero Header -->
    <header class="ishaya-collection__hero{% if collection.image and section.settings.show_collection_image %} ishaya-collection__hero--has-image{% endif %} ishaya-collection__hero--{{ section.settings.hero_style | default: 'compact' }}">
      {%- if collection.image and section.settings.show_collection_image -%}
        <div class="ishaya-collection__hero-media" aria-hidden="true">
          {{
            collection.image
            | image_url: width: 2560
            | image_tag:
              loading: 'eager',
              class: 'ishaya-collection__hero-img',
              alt: collection.title | escape
          }}
          <div class="ishaya-collection__hero-overlay"></div>
        </div>
      {%- endif -%}

      <div class="page-container ishaya-collection__hero-container">
        <div class="ishaya-collection__hero-content">
          <div class="ishaya-collection__hero-tags">
            <span class="ishaya-collection__hero-badge glass-panel">
              {{ collection.all_products_count }} PIECES IN ARCHIVE
            </span>
          </div>

          <h1 class="ishaya-collection__title">
            {{ collection.title }}
          </h1>

          {%- if collection.description != blank -%}
            <div class="ishaya-collection__desc">
              {{ collection.description }}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%}
        Coverflow collection slider. The active card sits at full scale while its
        neighbours recede in scale, opacity and rotateY, giving depth without a
        carousel library.
      {%- endcomment -%}
      {%- assign slides = section.blocks | where: 'type', 'slide' -%}
      {%- if slides.size > 0 -%}
        <div
          class="ishaya-coverflow"
          data-coverflow
          data-autoplay="{{ section.settings.slider_autoplay }}"
          data-autoplay-speed="{{ section.settings.slider_speed | default: 5 }}"
        >
          <div class="ishaya-coverflow__viewport" data-coverflow-viewport>
            <ul class="ishaya-coverflow__track" data-coverflow-track>
              {%- for block in slides -%}
                {%- liquid
                  assign slide_collection = block.settings.collection
                  assign slide_image = block.settings.image | default: slide_collection.image
                  assign slide_title = block.settings.title | default: slide_collection.title
                  assign slide_url = block.settings.link | default: slide_collection.url
                -%}
                <li
                  class="ishaya-coverflow__slide"
                  data-coverflow-slide
                  data-index="{{ forloop.index0 }}"
                  {{ block.shopify_attributes }}
                >
                  <a class="ishaya-coverflow__card" href="{{ slide_url | default: '#' }}">
                    <div class="ishaya-coverflow__media">
                      {%- if slide_image != blank -%}
                        {{
                          slide_image
                          | image_url: width: 900
                          | image_tag:
                            class: 'ishaya-coverflow__img',
                            widths: '300, 450, 600, 900',
                            sizes: '(min-width: 750px) 40vw, 80vw',
                            loading: 'lazy',
                            alt: slide_title | default: 'Collection' | escape
                        }}
                      {%- else -%}
                        <div class="ishaya-coverflow__placeholder">
                          {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {%- endif -%}
                    </div>

                    <div class="ishaya-coverflow__caption">
                      <span class="ishaya-coverflow__name">{{ slide_title | escape }}</span>
                      {%- if slide_collection != blank -%}
                        <span class="ishaya-coverflow__count">
                          {{- slide_collection.all_products_count }} pieces
                        </span>
                      {%- endif -%}
                    </div>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>

          {%- if slides.size > 1 -%}
            <button
              type="button"
              class="ishaya-coverflow__nav ishaya-coverflow__nav--prev"
              data-coverflow-prev
              aria-label="Previous collection"
            >
              {% render 'icons', name: 'arrow-left', width: 16, height: 16 %}
            </button>
            <button
              type="button"
              class="ishaya-coverflow__nav ishaya-coverflow__nav--next"
              data-coverflow-next
              aria-label="Next collection"
            >
              {% render 'icons', name: 'arrow-right', width: 16, height: 16 %}
            </button>

            <div class="ishaya-coverflow__dots" role="tablist" aria-label="Collection slides">
              {%- for block in slides -%}
                <button
                  type="button"
                  class="ishaya-coverflow__dot"
                  data-coverflow-dot
                  data-index="{{ forloop.index0 }}"
                  role="tab"
                  aria-label="Go to slide {{ forloop.index }}"
                  aria-selected="false"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </header>

    <!-- Category Quick-Pills: horizontal scrolling capsule navigation across collections -->
    {%- if section.settings.category_menu != blank -%}
      <nav class="page-container ishaya-collection__categories" aria-label="Browse collections">
        <ul class="ishaya-collection__category-list">
          <li>
            <a
              href="{{ routes.all_products_collection_url }}"
              class="ishaya-collection__category-pill{% if collection.handle == blank %} ishaya-collection__category-pill--active{% endif %}"
            >
              All
            </a>
          </li>
          {%- for link in section.settings.category_menu.links -%}
            <li>
              <a
                href="{{ link.url }}"
                class="ishaya-collection__category-pill{% if link.active or link.object.handle == collection.handle %} ishaya-collection__category-pill--active{% endif %}"
                {% if link.object.handle == collection.handle %}aria-current="page"{% endif %}
              >
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <!-- Controls Bar: Filtering & Sorting -->
    <div class="ishaya-collection__controls-bar full-width">
      <div class="page-container ishaya-collection__controls-inner">
        <!-- Left: Filter Trigger Button -->
        <div class="ishaya-collection__filter-toggle-wrap">
          {%- if has_filters -%}
            <button
              type="button"
              class="btn btn--secondary ishaya-collection__filter-btn glass-panel"
              id="FilterDrawerOpenBtn"
              aria-expanded="false"
              aria-controls="CollectionFilterDrawer"
            >
              {% render 'icons', name: 'menu', width: 14, height: 14 %}
              <span>FILTERS</span>
              {%- assign active_filter_count = 0 -%}
              {%- for filter in collection.filters -%}
                {%- assign active_filter_count = active_filter_count | plus: filter.active_values.size -%}
              {%- endfor -%}
              {%- if active_filter_count > 0 -%}
                <span class="ishaya-collection__filter-count-badge">{{ active_filter_count }}</span>
              {%- endif -%}
            </button>
          {%- endif -%}

          <span class="ishaya-collection__results-count" data-results-count>
            Showing {{ collection.products.size }} of {{ collection.products_count }}
          </span>
        </div>

        <!-- Right: Sort & Grid View Switcher -->
        <div class="ishaya-collection__tools-right">
          {%- if section.settings.enable_layout_switcher -%}
            <div class="ishaya-collection__layout-switch" role="group" aria-label="Grid density">
              <button
                type="button"
                class="ishaya-collection__layout-btn"
                data-layout="2"
                aria-label="Two column view"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
                  <rect x="3" y="3" width="7.5" height="18"></rect>
                  <rect x="13.5" y="3" width="7.5" height="18"></rect>
                </svg>
              </button>
              <button
                type="button"
                class="ishaya-collection__layout-btn is-active"
                data-layout="4"
                aria-label="Four column view"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
                  <rect x="3" y="3" width="7.5" height="7.5"></rect>
                  <rect x="13.5" y="3" width="7.5" height="7.5"></rect>
                  <rect x="3" y="13.5" width="7.5" height="7.5"></rect>
                  <rect x="13.5" y="13.5" width="7.5" height="7.5"></rect>
                </svg>
              </button>
              <button
                type="button"
                class="ishaya-collection__layout-btn"
                data-layout="6"
                aria-label="Six column dense view"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
                  <rect x="2.5" y="3" width="5" height="7.5"></rect>
                  <rect x="9.5" y="3" width="5" height="7.5"></rect>
                  <rect x="16.5" y="3" width="5" height="7.5"></rect>
                  <rect x="2.5" y="13.5" width="5" height="7.5"></rect>
                  <rect x="9.5" y="13.5" width="5" height="7.5"></rect>
                  <rect x="16.5" y="13.5" width="5" height="7.5"></rect>
                </svg>
              </button>
            </div>
          {%- endif -%}

          {%- if section.settings.enable_sorting -%}
            <div class="ishaya-collection__sort-wrap">
              <label for="SortBySelect" class="sr-only">Sort collection by</label>
              <select
                name="sort_by"
                id="SortBySelect"
                class="ishaya-collection__sort-select glass-panel"
                data-collection-url="{{ collection.url }}"
              >
                {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
                {%- for option in collection.sort_options -%}
                  <option
                    value="{{ option.value }}"
                    {% if option.value == current_sort %}selected="selected"{% endif %}
                  >
                    SORT: {{ option.name | upcase }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- Active Filters Strip -->
    {%- if has_filters -%}
      {%- assign total_active = 0 -%}
      {%- for filter in collection.filters -%}
        {%- assign total_active = total_active | plus: filter.active_values.size -%}
      {%- endfor -%}

      {%- if total_active > 0 -%}
        <div class="page-container ishaya-collection__active-filters">
          <span class="ishaya-collection__active-label">Active Filters:</span>
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a
                href="{{ value.url_to_remove }}"
                class="ishaya-collection__active-chip glass-panel"
                aria-label="Remove filter: {{ filter.label }} - {{ value.label }}"
              >
                <span>{{ filter.label }}: {{ value.label }}</span>
                {% render 'icons', name: 'close', width: 10, height: 10 %}
              </a>
            {%- endfor -%}
          {%- endfor -%}
          <a
            href="{{ collection.url }}"
            class="ishaya-collection__clear-all"
            aria-label="Clear all applied filters"
          >
            Clear All
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}

    <!-- Main Content: Products Grid & Filter Drawer -->
    <div
      class="ishaya-collection__grid-container{% if section.settings.full_bleed_grid %} ishaya-collection__grid-container--full{% else %} page-container{% endif %}"
      data-collection-results
    >
      {%- if collection.products.size > 0 -%}
        <div
          class="ishaya-product-grid ishaya-product-grid--cols-{{ cols_desktop }} ishaya-product-grid--mobile-2"
          id="CollectionProductGrid"
          data-product-grid
        >
          {%- for product in collection.products -%}
            <div class="ishaya-product-grid__item">
              {% render 'product-card',
                product: product,
                show_secondary_image: true,
                show_vendor: false,
                show_quick_add: true
              %}
            </div>
          {%- endfor -%}
        </div>

        <!-- Pagination -->
        {%- if paginate.pages > 1 -%}
          {%- if section.settings.pagination_style == 'load_more' -%}
            <div class="ishaya-collection__load-more-wrap">
              {%- if paginate.next -%}
                <button
                  type="button"
                  class="btn btn--secondary ishaya-collection__load-more"
                  data-load-more
                  data-next-url="{{ paginate.next.url }}"
                >
                  <span data-load-more-label>
                    LOAD MORE — SHOWING {{ collection.products.size }} OF {{ collection.products_count }}
                  </span>
                </button>
              {%- endif -%}

              {%- comment -%} Numbered links remain for crawlers and no-JS visitors. {%- endcomment -%}
              <noscript>
                <div class="ishaya-collection__pagination" role="navigation" aria-label="Pagination">
                  {{ paginate | default_pagination: next: 'Next →', previous: '← Prev' }}
                </div>
              </noscript>
            </div>
          {%- else -%}
            <div class="ishaya-collection__pagination" role="navigation" aria-label="Pagination">
              {{ paginate | default_pagination: next: 'Next →', previous: '← Prev' }}
            </div>
          {%- endif -%}
        {%- endif -%}

      {%- else -%}
        <!-- Empty Results State -->
        <div class="ishaya-collection__empty glass-panel">
          <div class="ishaya-collection__empty-inner">
            <span class="ishaya-collection__empty-tag">ZERO RESULTS</span>
            <h2 class="ishaya-collection__empty-title">NO MATCHING PIECES FOUND</h2>
            <p class="ishaya-collection__empty-text">
              None of our current archival garments match your selected filter criteria. Try resetting filters or exploring the general catalog.
            </p>
            <a href="{{ collection.url }}" class="btn btn--primary ishaya-collection__empty-btn">
              <span>RESET ALL FILTERS</span>
              {% render 'icons', name: 'arrow-right', width: 14, height: 14 %}
            </a>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Editorial / SEO copy and FAQ, below the catalog and above the footer -->
    {%- if section.settings.bottom_heading != blank
        or section.settings.bottom_text != blank
        or section.blocks.size > 0
    -%}
      <aside class="page-container ishaya-collection__editorial">
        {%- if section.settings.bottom_heading != blank -%}
          <h2 class="ishaya-collection__editorial-title">{{ section.settings.bottom_heading }}</h2>
        {%- endif -%}

        {%- if section.settings.bottom_text != blank -%}
          <div class="ishaya-collection__editorial-body rte">{{ section.settings.bottom_text }}</div>
        {%- endif -%}

        {%- assign faq_blocks = section.blocks | where: 'type', 'faq_item' -%}
        {%- if faq_blocks.size > 0 -%}
          <h3 class="ishaya-collection__faq-title">Frequently asked questions</h3>

          <div class="ishaya-collection__faq">
            {%- for block in faq_blocks -%}
              <details class="ishaya-collection__faq-item" {{ block.shopify_attributes }}>
                <summary class="ishaya-collection__faq-q">
                  <span>{{ block.settings.question }}</span>
                  <span class="ishaya-collection__faq-chevron" aria-hidden="true">
                    {% render 'icons', name: 'chevron-down', width: 12, height: 12 %}
                  </span>
                </summary>
                <div class="ishaya-collection__faq-a rte">{{ block.settings.answer }}</div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </aside>
    {%- endif -%}

    <!-- Filter Drawer (Slide-out) -->
    {%- if has_filters -%}
      <div
        id="CollectionFilterDrawer"
        class="ishaya-filter-drawer"
        role="dialog"
        aria-modal="true"
        aria-label="Collection Filters"
        hidden
      >
        <div class="ishaya-filter-drawer__backdrop" data-close-filters></div>
        <div class="ishaya-filter-drawer__panel glass-panel">
          <div class="ishaya-filter-drawer__header">
            <h2 class="ishaya-filter-drawer__title">FILTERS & REFINE</h2>
            <button
              type="button"
              class="ishaya-filter-drawer__close-btn"
              data-close-filters
              aria-label="Close filters"
            >
              {% render 'icons', name: 'close', width: 18, height: 18 %}
            </button>
          </div>

          <!-- Filters Form -->
          <form id="CollectionFiltersForm" class="ishaya-filter-drawer__form">
            <div class="ishaya-filter-drawer__groups">
              {%- for filter in collection.filters -%}
                <details class="ishaya-filter-group" open>
                  <summary class="ishaya-filter-group__summary">
                    <span class="ishaya-filter-group__label">{{ filter.label }}</span>
                    <span class="ishaya-filter-group__chevron" aria-hidden="true">
                      {% render 'icons', name: 'chevron-down', width: 12, height: 12 %}
                    </span>
                  </summary>

                  <div class="ishaya-filter-group__content">
                    {%- case filter.type -%}
                      {%- when 'list' or 'boolean' -%}
                        <ul class="ishaya-filter-list">
                          {%- for filter_value in filter.values -%}
                            <li class="ishaya-filter-item">
                              <label class="ishaya-filter-checkbox-label">
                                <input
                                  type="checkbox"
                                  name="{{ filter_value.param_name }}"
                                  value="{{ filter_value.value }}"
                                  class="ishaya-filter-checkbox"
                                  {% if filter_value.active %}checked="checked"{% endif %}
                                  {% if filter_value.count == 0 and filter_value.active == false %}disabled="disabled"{% endif %}
                                >
                                <span class="ishaya-filter-custom-check" aria-hidden="true">
                                  {% render 'icons', name: 'check', width: 10, height: 10 %}
                                </span>
                                <span class="ishaya-filter-item-name{% if filter_value.count == 0 and filter_value.active == false %} ishaya-filter-item-name--disabled{% endif %}">
                                  {{ filter_value.label }}
                                </span>
                                <span class="ishaya-filter-item-count">({{ filter_value.count }})</span>
                              </label>
                            </li>
                          {%- endfor -%}
                        </ul>

                      {%- when 'price_range' -%}
                        {%- liquid
                          assign price_max = filter.range_max | divided_by: 100
                          assign price_min_value = 0
                          if filter.min_value.value
                            assign price_min_value = filter.min_value.value | divided_by: 100
                          endif
                          assign price_max_value = price_max
                          if filter.max_value.value
                            assign price_max_value = filter.max_value.value | divided_by: 100
                          endif
                        -%}

                        <div
                          class="ishaya-filter-slider"
                          data-price-slider
                          data-range-max="{{ price_max }}"
                        >
                          <div class="ishaya-filter-slider__track" aria-hidden="true">
                            <div class="ishaya-filter-slider__fill" data-slider-fill></div>
                          </div>
                          <input
                            type="range"
                            class="ishaya-filter-slider__input ishaya-filter-slider__input--min"
                            data-slider-min
                            min="0"
                            max="{{ price_max }}"
                            value="{{ price_min_value }}"
                            aria-label="Minimum price"
                          >
                          <input
                            type="range"
                            class="ishaya-filter-slider__input ishaya-filter-slider__input--max"
                            data-slider-max
                            min="0"
                            max="{{ price_max }}"
                            value="{{ price_max_value }}"
                            aria-label="Maximum price"
                          >
                        </div>

                        <div class="ishaya-filter-price-range">
                          <div class="ishaya-filter-price-input-wrap">
                            <span class="ishaya-filter-price-cur">{{ cart.currency.symbol }}</span>
                            <input
                              name="{{ filter.min_value.param_name }}"
                              id="FilterPriceMin"
                              type="number"
                              placeholder="0"
                              min="0"
                              max="{{ filter.range_max | divided_by: 100 }}"
                              {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100 }}"{% endif %}
                              class="ishaya-filter-price-input"
                              aria-label="Minimum price"
                            >
                          </div>
                          <span class="ishaya-filter-price-sep">to</span>
                          <div class="ishaya-filter-price-input-wrap">
                            <span class="ishaya-filter-price-cur">{{ cart.currency.symbol }}</span>
                            <input
                              name="{{ filter.max_value.param_name }}"
                              id="FilterPriceMax"
                              type="number"
                              placeholder="{{ filter.range_max | divided_by: 100 }}"
                              min="0"
                              max="{{ filter.range_max | divided_by: 100 }}"
                              {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100 }}"{% endif %}
                              class="ishaya-filter-price-input"
                              aria-label="Maximum price"
                            >
                          </div>
                        </div>
                    {%- endcase -%}
                  </div>
                </details>
              {%- endfor -%}
            </div>

            <div class="ishaya-filter-drawer__footer">
              <a href="{{ collection.url }}" class="btn btn--secondary ishaya-filter-drawer__reset-btn">
                Clear All
              </a>
              <button type="submit" class="btn btn--primary ishaya-filter-drawer__apply-btn">
                Apply Filters
              </button>
            </div>
          </form>
        </div>
      </div>
    {%- endif -%}
  </section>
{% endpaginate %}

<style>
  .ishaya-collection {
    background-color: var(--color-background);
    color: var(--color-foreground);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  /* Hero Header */
  .ishaya-collection__hero {
    position: relative;
    padding-top: clamp(3rem, 6vw, 6rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .ishaya-collection__hero--has-image {
    background: transparent;
  }

  .ishaya-collection__hero-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ishaya-collection__hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.6) contrast(1.1);
  }

  .ishaya-collection__hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(9, 9, 11, 0.4) 0%, rgba(9, 9, 11, 0.85) 100%);
  }

  .ishaya-collection__hero-container {
    position: relative;
    z-index: 2;
  }

  .ishaya-collection__hero-content {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .ishaya-collection__hero-badge {
    display: inline-flex;
    padding: 0.35rem 0.85rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    border-radius: var(--radius-pill);
    width: fit-content;
  }

  .ishaya-collection__title {
    font-size: clamp(2.25rem, 5vw, 4.25rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .ishaya-collection__desc {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 620px;
  }

  /* Controls Bar */
  .ishaya-collection__controls-bar {
    position: sticky;
    top: 70px;
    z-index: 20;
    background: var(--glass-scrim);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
  }

  .ishaya-collection__controls-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .ishaya-collection__filter-btn {
    min-height: 40px;
    padding: 0.4rem 1.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ishaya-collection__filter-count-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background-color: var(--color-foreground);
    color: var(--color-background);
    border-radius: 50%;
    font-size: 0.65rem;
    font-weight: 800;
  }

  .ishaya-collection__tools-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ishaya-collection__sort-select {
    min-height: 40px;
    padding: 0.4rem 1.25rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    color: var(--color-foreground);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    cursor: pointer;
    background-color: transparent;
  }

  .ishaya-collection__sort-select option {
    background-color: #121215;
    color: var(--color-foreground);
  }

  /* Active Filters */
  .ishaya-collection__active-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1.25rem;
  }

  .ishaya-collection__active-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ishaya-collection__active-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-foreground);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }

  .ishaya-collection__active-chip:hover {
    border-color: var(--color-foreground);
  }

  .ishaya-collection__clear-all {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: underline;
    margin-left: 0.5rem;
  }

  .ishaya-collection__clear-all:hover {
    color: var(--color-foreground);
  }

  /* Grid */
  .ishaya-collection__grid-container {
    padding-top: 2rem;
  }

  /* Pagination */
  .ishaya-collection__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .ishaya-collection__pagination .page,
  .ishaya-collection__pagination .prev,
  .ishaya-collection__pagination .next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding: 0 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    color: var(--color-foreground);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .ishaya-collection__pagination .page:hover,
  .ishaya-collection__pagination .prev:hover,
  .ishaya-collection__pagination .next:hover {
    border-color: var(--color-foreground);
    background-color: var(--glass-bg-hover);
  }

  .ishaya-collection__pagination .current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding: 0 0.75rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-foreground);
    color: var(--color-background);
    border: 1px solid var(--color-foreground);
  }

  /* Empty State */
  .ishaya-collection__empty {
    padding: clamp(3rem, 6vw, 5rem) 2rem;
    text-align: center;
    border-radius: var(--radius-input);
    border: 1px solid var(--color-border);
    max-width: 680px;
    margin: 2rem auto;
  }

  .ishaya-collection__empty-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .ishaya-collection__empty-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ishaya-collection__empty-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
  }

  .ishaya-collection__empty-text {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0;
  }

  .ishaya-collection__empty-btn {
    margin-top: 0.5rem;
  }

  /* Filter Drawer */
  .ishaya-filter-drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
  }

  .ishaya-filter-drawer[hidden] {
    display: none;
  }

  .ishaya-filter-drawer__backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(6px);
  }

  .ishaya-filter-drawer__panel {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 420px;
    height: 100%;
    background-color: #0e0e11;
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    animation: drawerSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes drawerSlideIn {
    from { transform: translateX(-100%); }
    to { transform: translateX(0); }
  }

  .ishaya-filter-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .ishaya-filter-drawer__title {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }

  .ishaya-filter-drawer__close-btn {
    background: transparent;
    border: none;
    color: var(--color-foreground);
    cursor: pointer;
    display: flex;
    padding: 0.25rem;
  }

  .ishaya-filter-drawer__form {
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
  }

  .ishaya-filter-drawer__groups {
    padding: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .ishaya-filter-group {
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 0;
  }

  .ishaya-filter-group__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.5rem 0;
  }

  .ishaya-filter-group__summary::-webkit-details-marker {
    display: none;
  }

  .ishaya-filter-group__chevron {
    transition: transform var(--transition-smooth);
    color: var(--color-muted);
  }

  .ishaya-filter-group[open] .ishaya-filter-group__chevron {
    transform: rotate(180deg);
    color: var(--color-foreground);
  }

  .ishaya-filter-group__content {
    padding: 0.75rem 0;
  }

  .ishaya-filter-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .ishaya-filter-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    font-size: 0.82rem;
    user-select: none;
  }

  .ishaya-filter-checkbox {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .ishaya-filter-custom-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: transparent;
    color: transparent;
    transition: all var(--transition-fast);
  }

  .ishaya-filter-checkbox:checked + .ishaya-filter-custom-check {
    background: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }

  .ishaya-filter-item-name {
    flex: 1;
    color: var(--color-foreground);
  }

  .ishaya-filter-item-name--disabled {
    opacity: 0.4;
  }

  .ishaya-filter-item-count {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  /* Price Range */
  .ishaya-filter-price-range {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ishaya-filter-price-input-wrap {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    padding: 0.4rem 0.65rem;
    flex: 1;
  }

  .ishaya-filter-price-cur {
    color: var(--color-muted);
    font-size: 0.8rem;
    margin-right: 0.25rem;
  }

  .ishaya-filter-price-input {
    border: none !important;
    padding: 0 !important;
    background: transparent !important;
    font-size: 0.82rem;
    color: var(--color-foreground) !important;
    box-shadow: none !important;
    width: 100%;
  }

  .ishaya-filter-price-sep {
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .ishaya-filter-drawer__footer {
    display: flex;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-border);
    background-color: #0e0e11;
  }

  .ishaya-filter-drawer__reset-btn {
    flex: 1;
    min-height: 44px;
  }

  .ishaya-filter-drawer__apply-btn {
    flex: 2;
    min-height: 44px;
  }
  /* ----------------------------------------------------------------------
     Breadcrumbs
     ---------------------------------------------------------------------- */
  .ishaya-collection__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 5.5rem;
    padding-bottom: 1rem;
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ishaya-collection__crumb {
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .ishaya-collection__crumb:hover {
    color: var(--color-foreground);
  }

  .ishaya-collection__crumb--current {
    color: var(--color-foreground);
  }

  .ishaya-collection__crumb-sep {
    color: var(--color-muted);
    opacity: 0.5;
  }

  /* Compact header trims the vertical drama of the full-bleed variant. */
  .ishaya-collection__hero--compact:not(.ishaya-collection__hero--has-image) {
    min-height: 0;
    padding: 0 0 1.5rem;
  }

  .ishaya-collection__hero--compact .ishaya-collection__title {
    font-size: clamp(1.6rem, 4vw, 2.75rem);
  }

  /* ----------------------------------------------------------------------
     Category quick-pills
     ---------------------------------------------------------------------- */
  .ishaya-collection__categories {
    padding-bottom: 1rem;
  }

  .ishaya-collection__category-list {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    padding: 0 0 0.25rem;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .ishaya-collection__category-list::-webkit-scrollbar {
    display: none;
  }

  .ishaya-collection__category-pill {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 0.95rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    background-color: var(--glass-bg);
    color: var(--color-muted);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .ishaya-collection__category-pill:hover {
    background-color: var(--glass-bg-hover);
    color: var(--color-foreground);
  }

  .ishaya-collection__category-pill--active {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  /* ----------------------------------------------------------------------
     Controls bar additions
     ---------------------------------------------------------------------- */
  .ishaya-collection__filter-toggle-wrap {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .ishaya-collection__results-count {
    color: var(--color-muted);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ishaya-collection__layout-switch {
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
  }

  .ishaya-collection__layout-btn {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .ishaya-collection__layout-btn:hover {
    color: var(--color-foreground);
  }

  .ishaya-collection__layout-btn.is-active {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  /* Full-screen catalog: the grid escapes the page container edge to edge. */
  .ishaya-collection__grid-container--full {
    width: 100%;
    padding-right: clamp(0.75rem, 2vw, 2rem);
    padding-left: clamp(0.75rem, 2vw, 2rem);
  }

  /* ----------------------------------------------------------------------
     Load more
     ---------------------------------------------------------------------- */
  .ishaya-collection__load-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .ishaya-collection__load-more {
    min-width: 260px;
    min-height: 44px;
    font-variant-numeric: tabular-nums;
  }

  .ishaya-collection__load-more.is-loading {
    opacity: 0.6;
    pointer-events: none;
  }

  /* ----------------------------------------------------------------------
     Price dual-range slider
     ---------------------------------------------------------------------- */
  .ishaya-filter-slider {
    position: relative;
    height: 28px;
    margin-bottom: 0.75rem;
  }

  .ishaya-filter-slider__track {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 3px;
    border-radius: var(--radius-pill);
    background-color: var(--glass-border);
    transform: translateY(-50%);
  }

  .ishaya-filter-slider__fill {
    position: absolute;
    top: 0;
    height: 100%;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
  }

  /* Both inputs are stacked; only their thumbs accept pointer events. */
  .ishaya-filter-slider__input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 28px;
    margin: 0;
    background: none;
    pointer-events: none;
    appearance: none;
    -webkit-appearance: none;
  }

  .ishaya-filter-slider__input::-webkit-slider-thumb {
    width: 16px;
    height: 16px;
    border: 2px solid var(--color-background);
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    cursor: grab;
    pointer-events: auto;
    appearance: none;
    -webkit-appearance: none;
  }

  .ishaya-filter-slider__input::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 2px solid var(--color-background);
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    cursor: grab;
    pointer-events: auto;
  }

  .ishaya-filter-slider__input:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  @media (max-width: 767px) {
    .ishaya-collection__breadcrumbs {
      padding-top: 4.5rem;
    }

    .ishaya-collection__results-count {
      display: none;
    }

    .ishaya-collection__layout-switch {
      display: none;
    }

    .ishaya-collection__load-more {
      width: 100%;
      min-width: 0;
    }
  }

  /* ----------------------------------------------------------------------
     Editorial copy & FAQ
     ---------------------------------------------------------------------- */
  .ishaya-collection__editorial {
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: clamp(1rem, 3vw, 2rem);
    max-width: 52rem;
  }

  .ishaya-collection__editorial-title {
    margin: 0 0 1rem;
    font-size: clamp(0.85rem, 2vw, 1.05rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.5;
  }

  .ishaya-collection__editorial-body {
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.8;
  }

  .ishaya-collection__editorial-body p {
    margin: 0 0 0.85rem;
  }

  .ishaya-collection__faq-title {
    margin: 2.5rem 0 1rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ishaya-collection__faq {
    border-top: 1px solid var(--color-border);
  }

  .ishaya-collection__faq-item {
    border-bottom: 1px solid var(--color-border);
  }

  .ishaya-collection__faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    cursor: pointer;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    list-style: none;
  }

  .ishaya-collection__faq-q::-webkit-details-marker {
    display: none;
  }

  .ishaya-collection__faq-chevron {
    display: flex;
    flex-shrink: 0;
    color: var(--color-muted);
    transition: transform var(--transition-smooth);
  }

  .ishaya-collection__faq-item[open] .ishaya-collection__faq-chevron {
    transform: rotate(180deg);
  }

  .ishaya-collection__faq-a {
    padding: 0 0 1.1rem;
    color: var(--color-muted);
    font-size: 0.72rem;
    line-height: 1.8;
  }

  .ishaya-collection__faq-a p {
    margin: 0 0 0.6rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .ishaya-collection__faq-chevron {
      transition: none;
    }
  }

  /* ----------------------------------------------------------------------
     Coverflow collection slider
     ---------------------------------------------------------------------- */
  .ishaya-coverflow {
    position: relative;
    margin-top: clamp(1.25rem, 3vw, 2.25rem);
    padding-bottom: 2.25rem;
  }

  .ishaya-coverflow__viewport {
    overflow: hidden;
    /* Depth for the rotateY on the flanking cards. */
    perspective: 1400px;
    cursor: grab;
  }

  .ishaya-coverflow__viewport.is-dragging {
    cursor: grabbing;
  }

  .ishaya-coverflow__track {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    margin: 0;
    padding: 1.5rem 0;
    list-style: none;
    transform-style: preserve-3d;
  }

  .ishaya-coverflow__slide {
    flex: 0 0 auto;
    width: clamp(220px, 30vw, 380px);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    /* Default = a distant slide; the active/adjacent rules below override. */
    opacity: 0;
    transform: scale(0.8);
    pointer-events: none;
  }

  .ishaya-coverflow__slide.is-active {
    z-index: 10;
    opacity: 1;
    transform: scale(1);
    filter: none;
    pointer-events: auto;
  }

  .ishaya-coverflow__slide.is-prev,
  .ishaya-coverflow__slide.is-next {
    z-index: 5;
    opacity: 0.35;
    filter: blur(2px);
    pointer-events: auto;
  }

  .ishaya-coverflow__slide.is-prev {
    transform: scale(0.88) rotateY(15deg);
  }

  .ishaya-coverflow__slide.is-next {
    transform: scale(0.88) rotateY(-15deg);
  }

  .ishaya-coverflow__card {
    display: block;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    background-color: var(--color-surface);
    color: var(--color-foreground);
    text-decoration: none;
    box-shadow: var(--glass-shadow);
  }

  .ishaya-coverflow__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .ishaya-coverflow__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .ishaya-coverflow__slide.is-active .ishaya-coverflow__card:hover .ishaya-coverflow__img {
      transform: scale(1.05);
    }
  }

  .ishaya-coverflow__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background-color: var(--color-surface);
  }

  .ishaya-coverflow__placeholder .placeholder-svg {
    width: 100%;
    height: 100%;
    fill: var(--color-border);
  }

  .ishaya-coverflow__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
  }

  .ishaya-coverflow__name {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .ishaya-coverflow__count {
    color: var(--color-muted);
    font-size: 0.5rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* --- Navigation --- */
  .ishaya-coverflow__nav {
    position: absolute;
    top: calc(50% - 1.1rem);
    z-index: 20;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    background-color: var(--surface-floating);
    color: var(--color-foreground);
    cursor: pointer;
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--shadow-floating-sm);
    transform: translateY(-50%);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .ishaya-coverflow__nav:hover {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .ishaya-coverflow__nav:active {
    transform: translateY(-50%) scale(0.92);
  }

  .ishaya-coverflow__nav--prev {
    left: clamp(0.5rem, 3vw, 3rem);
  }

  .ishaya-coverflow__nav--next {
    right: clamp(0.5rem, 3vw, 3rem);
  }

  .ishaya-coverflow__dots {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .ishaya-coverflow__dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: var(--color-border);
    cursor: pointer;
    transition: width var(--transition-smooth), background-color var(--transition-fast);
  }

  .ishaya-coverflow__dot[aria-selected='true'] {
    width: 20px;
    background-color: var(--color-accent);
  }

  @media (max-width: 767px) {
    .ishaya-coverflow__slide {
      width: 72vw;
    }

    .ishaya-coverflow__nav {
      width: 34px;
      height: 34px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ishaya-coverflow__slide,
    .ishaya-coverflow__img,
    .ishaya-coverflow__dot {
      transition: none;
    }
    .ishaya-coverflow__slide.is-prev,
    .ishaya-coverflow__slide.is-next {
      filter: none;
      transform: scale(0.88);
    }
  }

</style>

<script>
  (function() {
    // Sorting is handled by the AJAX block below — no full page reload here.

    // Filter Drawer Toggle
    const filterBtn = document.getElementById('FilterDrawerOpenBtn');
    const filterDrawer = document.getElementById('CollectionFilterDrawer');
    if (filterBtn && filterDrawer) {
      function openFilters() {
        filterDrawer.removeAttribute('hidden');
        document.body.classList.add('drawer-open');
        filterBtn.setAttribute('aria-expanded', 'true');
      }

      function closeFilters() {
        filterDrawer.setAttribute('hidden', '');
        document.body.classList.remove('drawer-open');
        filterBtn.setAttribute('aria-expanded', 'false');
      }

      filterBtn.addEventListener('click', openFilters);

      filterDrawer.querySelectorAll('[data-close-filters]').forEach(function(el) {
        el.addEventListener('click', closeFilters);
      });

      document.addEventListener('keydown', function(evt) {
        if (evt.key === 'Escape' && !filterDrawer.hasAttribute('hidden')) {
          closeFilters();
        }
      });
    }
  })();
  /* ----------------------------------------------------------------------
     AJAX filtering, sorting, load more, layout switcher and price slider.

     Filtering and sorting re-render this section through the Section Rendering
     API and swap only the results region, so the filter drawer keeps its state
     and the URL stays shareable via pushState.
     ---------------------------------------------------------------------- */
  (function () {
    const section = document.getElementById('CollectionSection-{{ section.id }}');
    if (!section) return;

    const sectionId = {{ section.id | json }};
    const resultsRegion = section.querySelector('[data-collection-results]');
    const form = document.getElementById('CollectionFiltersForm');
    const sortSelect = document.getElementById('SortBySelect');

    /* ---------- Price dual-range slider ---------- */
    function initPriceSlider() {
      const slider = section.querySelector('[data-price-slider]');
      if (!slider) return;

      const minInput = slider.querySelector('[data-slider-min]');
      const maxInput = slider.querySelector('[data-slider-max]');
      const fill = slider.querySelector('[data-slider-fill]');
      const rangeMax = parseFloat(slider.getAttribute('data-range-max')) || 0;
      const minField = document.getElementById('FilterPriceMin');
      const maxField = document.getElementById('FilterPriceMax');
      if (!minInput || !maxInput || rangeMax <= 0) return;

      function paint() {
        const lo = parseFloat(minInput.value);
        const hi = parseFloat(maxInput.value);
        if (fill) {
          fill.style.left = (lo / rangeMax) * 100 + '%';
          fill.style.width = ((hi - lo) / rangeMax) * 100 + '%';
        }
      }

      minInput.addEventListener('input', function () {
        // Keep the handles from crossing over each other.
        if (parseFloat(minInput.value) > parseFloat(maxInput.value)) {
          minInput.value = maxInput.value;
        }
        if (minField) minField.value = minInput.value;
        paint();
      });

      maxInput.addEventListener('input', function () {
        if (parseFloat(maxInput.value) < parseFloat(minInput.value)) {
          maxInput.value = minInput.value;
        }
        if (maxField) maxField.value = maxInput.value;
        paint();
      });

      [minInput, maxInput].forEach(function (el) {
        el.addEventListener('change', applyFilters);
      });

      // Typing in the number fields drives the handles too.
      if (minField) {
        minField.addEventListener('input', function () {
          minInput.value = minField.value || 0;
          paint();
        });
      }
      if (maxField) {
        maxField.addEventListener('input', function () {
          maxInput.value = maxField.value || rangeMax;
          paint();
        });
      }

      paint();
    }

    /* ---------- Section Rendering API swap ---------- */
    function renderFromUrl(url, options) {
      const opts = options || {};
      if (resultsRegion) resultsRegion.setAttribute('aria-busy', 'true');

      const fetchUrl = url + (url.indexOf('?') === -1 ? '?' : '&') + 'section_id=' + encodeURIComponent(sectionId);

      return fetch(fetchUrl)
        .then(function (res) {
          if (!res.ok) throw new Error('Could not load results');
          return res.text();
        })
        .then(function (html) {
          const parsed = new DOMParser().parseFromString(html, 'text/html');

          // Swap only the regions that change, so drawer state survives.
          ['[data-collection-results]', '[data-results-count]'].forEach(function (selector) {
            const next = parsed.querySelector(selector);
            const current = section.querySelector(selector);
            if (next && current) current.innerHTML = next.innerHTML;
          });

          const nextFilters = parsed.querySelector('.ishaya-collection__active-filters');
          const currentFilters = section.querySelector('.ishaya-collection__active-filters');
          if (nextFilters && currentFilters) {
            currentFilters.innerHTML = nextFilters.innerHTML;
          } else if (currentFilters && !nextFilters) {
            currentFilters.innerHTML = '';
          }

          if (!opts.keepScroll) {
            const top = section.getBoundingClientRect().top + window.scrollY - 120;
            window.scrollTo({ top: top, behavior: 'smooth' });
          }

          applyLayout(currentLayout());
          document.dispatchEvent(new CustomEvent('ishaya:grid:updated'));
        })
        .catch(function () {
          // A failed swap should still get the visitor to the right page.
          window.location.href = url;
        })
        .finally(function () {
          if (resultsRegion) resultsRegion.removeAttribute('aria-busy');
        });
    }

    function buildUrl() {
      const params = new URLSearchParams();

      if (form) {
        new FormData(form).forEach(function (value, key) {
          if (value !== '') params.append(key, value);
        });
      }
      if (sortSelect && sortSelect.value) params.set('sort_by', sortSelect.value);

      const base = window.location.pathname;
      const query = params.toString();
      return query ? base + '?' + query : base;
    }

    function applyFilters() {
      const url = buildUrl();
      window.history.pushState({ url: url }, '', url);
      renderFromUrl(url, { keepScroll: true });
    }

    if (form) {
      form.addEventListener('change', applyFilters);
      form.addEventListener('submit', function (evt) {
        evt.preventDefault();
        applyFilters();
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', applyFilters);
    }

    // Active-filter chips and "clear all" are links — intercept them too.
    section.addEventListener('click', function (evt) {
      const chip = evt.target.closest('.ishaya-collection__active-chip, .ishaya-collection__clear-all');
      if (!chip || !chip.href) return;
      evt.preventDefault();
      const url = chip.href.replace(window.location.origin, '');
      window.history.pushState({ url: url }, '', url);
      renderFromUrl(url, { keepScroll: true });
    });

    window.addEventListener('popstate', function () {
      renderFromUrl(window.location.pathname + window.location.search, { keepScroll: true });
    });

    /* ---------- Load more ---------- */
    section.addEventListener('click', function (evt) {
      const btn = evt.target.closest('[data-load-more]');
      if (!btn) return;

      const nextUrl = btn.getAttribute('data-next-url');
      if (!nextUrl || btn.classList.contains('is-loading')) return;

      btn.classList.add('is-loading');
      const label = btn.querySelector('[data-load-more-label]');
      const original = label ? label.textContent : '';
      if (label) label.textContent = 'LOADING…';

      fetch(nextUrl + (nextUrl.indexOf('?') === -1 ? '?' : '&') + 'section_id=' + encodeURIComponent(sectionId))
        .then(function (res) {
          if (!res.ok) throw new Error('Could not load more');
          return res.text();
        })
        .then(function (html) {
          const parsed = new DOMParser().parseFromString(html, 'text/html');
          const newItems = parsed.querySelectorAll('[data-product-grid] .ishaya-product-grid__item');
          const grid = section.querySelector('[data-product-grid]');

          if (grid) {
            newItems.forEach(function (item) {
              grid.appendChild(item);
            });
          }

          // Carry the next page forward, or retire the button on the last page.
          const nextBtn = parsed.querySelector('[data-load-more]');
          if (nextBtn) {
            btn.setAttribute('data-next-url', nextBtn.getAttribute('data-next-url'));
            const nextLabel = nextBtn.querySelector('[data-load-more-label]');
            if (label && nextLabel) label.textContent = nextLabel.textContent.trim();
          } else {
            btn.remove();
          }

          const count = section.querySelector('[data-results-count]');
          const grid2 = section.querySelector('[data-product-grid]');
          if (count && grid2) {
            const shown = grid2.querySelectorAll('.ishaya-product-grid__item').length;
            count.textContent = count.textContent.replace(/Showing\s+\d+/i, 'Showing ' + shown);
          }

          applyLayout(currentLayout());
          document.dispatchEvent(new CustomEvent('ishaya:grid:updated'));
        })
        .catch(function () {
          if (label) label.textContent = original;
        })
        .finally(function () {
          btn.classList.remove('is-loading');
        });
    });

    /* ---------- Layout / grid density switcher ---------- */
    const LAYOUT_KEY = 'ishaya:collection-layout';

    function currentLayout() {
      try {
        return window.localStorage.getItem(LAYOUT_KEY) || '{{ cols_desktop }}';
      } catch (e) {
        return '{{ cols_desktop }}';
      }
    }

    function applyLayout(layout) {
      const grid = section.querySelector('[data-product-grid]');
      if (!grid) return;

      grid.classList.remove(
        'ishaya-product-grid--cols-2',
        'ishaya-product-grid--cols-3',
        'ishaya-product-grid--cols-4',
        'ishaya-product-grid--cols-6'
      );
      grid.classList.add('ishaya-product-grid--cols-' + layout);

      section.querySelectorAll('[data-layout]').forEach(function (btn) {
        btn.classList.toggle('is-active', btn.getAttribute('data-layout') === layout);
      });
    }

    section.addEventListener('click', function (evt) {
      const btn = evt.target.closest('[data-layout]');
      if (!btn) return;
      const layout = btn.getAttribute('data-layout');
      try {
        window.localStorage.setItem(LAYOUT_KEY, layout);
      } catch (e) {
        /* ignore */
      }
      applyLayout(layout);
    });

    initPriceSlider();
    applyLayout(currentLayout());
  })();

  /* ----------------------------------------------------------------------
     Coverflow collection slider — centring, drag, keyboard and autoplay.
     ---------------------------------------------------------------------- */
  (function () {
    const root = document.querySelector('[data-coverflow]');
    if (!root) return;

    const viewport = root.querySelector('[data-coverflow-viewport]');
    const track = root.querySelector('[data-coverflow-track]');
    const slides = Array.prototype.slice.call(root.querySelectorAll('[data-coverflow-slide]'));
    const dots = Array.prototype.slice.call(root.querySelectorAll('[data-coverflow-dot]'));
    if (!viewport || !track || slides.length === 0) return;

    let current = 0;
    let autoplayTimer = null;

    const reduceMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function update() {
      slides.forEach(function (slide, i) {
        slide.classList.remove('is-active', 'is-prev', 'is-next');
        if (i === current) slide.classList.add('is-active');
        else if (i === current - 1) slide.classList.add('is-prev');
        else if (i === current + 1) slide.classList.add('is-next');

        // Only the centred card is a tab stop.
        const link = slide.querySelector('a');
        if (link) link.tabIndex = i === current ? 0 : -1;
      });

      dots.forEach(function (dot, i) {
        dot.setAttribute('aria-selected', i === current ? 'true' : 'false');
      });

      // Centre the active slide by translating the track.
      const active = slides[current];
      const offset = active.offsetLeft + active.offsetWidth / 2 - viewport.offsetWidth / 2;
      track.style.transition = reduceMotion ? 'none' : 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
      track.style.transform = 'translateX(' + -offset + 'px)';
    }

    function goTo(index) {
      current = Math.max(0, Math.min(slides.length - 1, index));
      update();
    }

    root.querySelectorAll('[data-coverflow-prev]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        goTo(current - 1);
        stopAutoplay();
      });
    });

    root.querySelectorAll('[data-coverflow-next]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        goTo(current + 1);
        stopAutoplay();
      });
    });

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        goTo(parseInt(dot.getAttribute('data-index'), 10) || 0);
        stopAutoplay();
      });
    });

    // Clicking a flanking card centres it rather than following its link.
    slides.forEach(function (slide, i) {
      slide.addEventListener(
        'click',
        function (evt) {
          if (i !== current) {
            evt.preventDefault();
            goTo(i);
            stopAutoplay();
          }
        },
        true
      );
    });

    root.addEventListener('keydown', function (evt) {
      if (evt.key === 'ArrowLeft') {
        evt.preventDefault();
        goTo(current - 1);
        stopAutoplay();
      } else if (evt.key === 'ArrowRight') {
        evt.preventDefault();
        goTo(current + 1);
        stopAutoplay();
      }
    });

    /* ---- Pointer drag ---- */
    let dragStartX = 0;
    let dragging = false;

    viewport.addEventListener('pointerdown', function (evt) {
      dragging = true;
      dragStartX = evt.clientX;
      viewport.classList.add('is-dragging');
      viewport.setPointerCapture(evt.pointerId);
    });

    viewport.addEventListener('pointerup', function (evt) {
      if (!dragging) return;
      dragging = false;
      viewport.classList.remove('is-dragging');

      const delta = evt.clientX - dragStartX;
      const threshold = 60;
      if (delta > threshold) goTo(current - 1);
      else if (delta < -threshold) goTo(current + 1);
      if (Math.abs(delta) > threshold) stopAutoplay();
    });

    viewport.addEventListener('pointercancel', function () {
      dragging = false;
      viewport.classList.remove('is-dragging');
    });

    /* ---- Autoplay ---- */
    function startAutoplay() {
      if (reduceMotion) return;
      if (root.getAttribute('data-autoplay') !== 'true') return;
      const seconds = parseInt(root.getAttribute('data-autoplay-speed'), 10) || 5;
      autoplayTimer = window.setInterval(function () {
        goTo(current + 1 >= slides.length ? 0 : current + 1);
      }, seconds * 1000);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        window.clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('focusin', stopAutoplay);

    window.addEventListener('resize', update);
    update();
    startAutoplay();
  })();

</script>

