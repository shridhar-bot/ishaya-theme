{% comment %}
  ISHAYA Collection Tile Grid Section
  Curated architectural category grid with asymmetric card sizing,
  image zoom transitions, glass badge overlays, and theme block support.
{% endcomment %}

<section
  id="CollectionGrid-{{ section.id }}"
  class="ishaya-collection-grid-sec full-width"
  aria-label="{{ section.settings.title | escape }}"
>
  <div class="page-container">
    <!-- Header -->
    <div class="ishaya-collection-grid-sec__header">
      {%- if section.settings.tag != blank -%}
        <span class="ishaya-collection-grid-sec__tag">
          {{ section.settings.tag }}
        </span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="ishaya-collection-grid-sec__title">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="ishaya-collection-grid-sec__desc">
          {{ section.settings.description }}
        </p>
      {%- endif -%}
    </div>

    <!-- Grid of Tiles -->
    <div class="ishaya-collection-tiles">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_collection = block.settings.collection
          assign tile_img = block.settings.image | default: tile_collection.featured_image
          assign tile_title = block.settings.title | default: tile_collection.title | default: 'Collection'
          assign tile_url = tile_collection.url | default: routes.collections_url
          assign tile_width = block.settings.width | default: 'standard'
        -%}

        <div
          class="ishaya-collection-tile ishaya-collection-tile--{{ tile_width }}"
          {{ block.shopify_attributes }}
        >
          <a
            href="{{ tile_url }}"
            class="ishaya-collection-tile__link"
            aria-label="{{ tile_title | escape }}"
          >
            <!-- Media -->
            <div class="ishaya-collection-tile__media">
              {%- if tile_img != blank -%}
                {{
                  tile_img
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    class: 'ishaya-collection-tile__img',
                    alt: tile_title | escape
                }}
              {%- else -%}
                <div class="ishaya-collection-tile__placeholder">
                  {%- capture current_svg -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                  {{ 'collection-' | append: current_svg | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}

              <div class="ishaya-collection-tile__overlay" aria-hidden="true"></div>
            </div>

            <!-- Content Overlay -->
            <div class="ishaya-collection-tile__content">
              <div class="ishaya-collection-tile__top">
                {%- if block.settings.subtitle != blank -%}
                  <span class="ishaya-collection-tile__tag glass-panel">
                    {{ block.settings.subtitle }}
                  </span>
                {%- elsif tile_collection != blank and tile_collection.all_products_count > 0 -%}
                  <span class="ishaya-collection-tile__tag glass-panel">
                    {{ tile_collection.all_products_count }} PIECES
                  </span>
                {%- endif -%}
              </div>

              <div class="ishaya-collection-tile__bottom">
                <div class="ishaya-collection-tile__heading-row">
                  <h3 class="ishaya-collection-tile__heading">
                    {{ tile_title }}
                  </h3>
                  <div class="ishaya-collection-tile__arrow glass-panel" aria-hidden="true">
                    {% render 'icons', name: 'arrow-right', width: 14, height: 14 %}
                  </div>
                </div>
              </div>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .ishaya-collection-grid-sec {
    padding-top: clamp(3rem, 6vw, 6rem);
    padding-bottom: clamp(3rem, 6vw, 6rem);
    background-color: var(--color-background);
  }

  .ishaya-collection-grid-sec__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 650px;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .ishaya-collection-grid-sec__tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ishaya-collection-grid-sec__title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    line-height: 1.1;
    color: var(--color-foreground);
    margin: 0;
  }

  .ishaya-collection-grid-sec__desc {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* Grid Layout */
  .ishaya-collection-tiles {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
  }

  .ishaya-collection-tile {
    position: relative;
    border-radius: var(--radius-input);
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .ishaya-collection-tile:hover {
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
  }

  .ishaya-collection-tile--standard {
    grid-column: span 4;
    min-height: 380px;
  }

  .ishaya-collection-tile--wide {
    grid-column: span 6;
    min-height: 420px;
  }

  .ishaya-collection-tile--full {
    grid-column: span 12;
    min-height: 460px;
  }

  .ishaya-collection-tile__link {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    min-height: inherit;
    position: relative;
    text-decoration: none;
    padding: 1.75rem;
  }

  .ishaya-collection-tile__media {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .ishaya-collection-tile__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ishaya-collection-tile:hover .ishaya-collection-tile__img {
    transform: scale(1.05);
  }

  .ishaya-collection-tile__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #121215;
  }

  .ishaya-collection-tile__placeholder svg {
    width: 40%;
    height: 40%;
    opacity: 0.2;
  }

  .ishaya-collection-tile__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(9, 9, 11, 0.3) 0%,
      rgba(9, 9, 11, 0.2) 40%,
      rgba(9, 9, 11, 0.85) 100%
    );
    transition: opacity var(--transition-fast);
  }

  .ishaya-collection-tile:hover .ishaya-collection-tile__overlay {
    background: linear-gradient(
      180deg,
      rgba(9, 9, 11, 0.2) 0%,
      rgba(9, 9, 11, 0.1) 40%,
      rgba(9, 9, 11, 0.9) 100%
    );
  }

  /* Content */
  .ishaya-collection-tile__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    width: 100%;
  }

  .ishaya-collection-tile__tag {
    display: inline-flex;
    padding: 0.35rem 0.85rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
    border-radius: var(--radius-pill);
  }

  .ishaya-collection-tile__heading-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .ishaya-collection-tile__heading {
    font-size: clamp(1.25rem, 2.2vw, 1.85rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    line-height: 1.15;
  }

  .ishaya-collection-tile__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: #ffffff;
    flex-shrink: 0;
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .ishaya-collection-tile:hover .ishaya-collection-tile__arrow {
    transform: translateX(4px);
    background-color: rgba(255, 255, 255, 0.15);
  }

  @media (max-width: 1024px) {
    .ishaya-collection-tile--standard {
      grid-column: span 6;
    }
  }

  @media (max-width: 767px) {
    .ishaya-collection-tiles {
      gap: 1rem;
    }

    .ishaya-collection-tile--standard,
    .ishaya-collection-tile--wide,
    .ishaya-collection-tile--full {
      grid-column: span 12;
      min-height: 280px;
    }

    .ishaya-collection-tile__link {
      padding: 1.25rem;
    }
  }
</style>

{% schema %}
{
  "name": "Collection Tile Grid",
  "tag": "section",
  "class": "section-collection-tile-grid",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Section badge",
      "default": "SYSTEM CLASSIFICATION"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CATEGORIES & FORMS"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Subheading",
      "default": "Modular garments classified by technical utility and textile weight."
    }
  ],
  "blocks": [
    {
      "type": "collection_tile",
      "name": "Collection Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (optional override)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title (optional override)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Tag",
          "default": "TECHNICAL WEAR"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Tile Width",
          "options": [
            {
              "value": "standard",
              "label": "Standard (1/3 row)"
            },
            {
              "value": "wide",
              "label": "Wide (1/2 row)"
            },
            {
              "value": "full",
              "label": "Full (Full row)"
            }
          ],
          "default": "standard"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Tile Grid",
      "blocks": [
        {
          "type": "collection_tile",
          "settings": {
            "title": "OUTERWEAR",
            "subtitle": "WATERPROOF SHELLS",
            "width": "wide"
          }
        },
        {
          "type": "collection_tile",
          "settings": {
            "title": "CARGO & TROUSERS",
            "subtitle": "UTILITARIAN POCKETING",
            "width": "wide"
          }
        },
        {
          "type": "collection_tile",
          "settings": {
            "title": "HEAVY FLEECE",
            "subtitle": "500GSM COTTON",
            "width": "standard"
          }
        },
        {
          "type": "collection_tile",
          "settings": {
            "title": "TACTICAL ACCESSORIES",
            "subtitle": "MODULAR POUCHES",
            "width": "standard"
          }
        },
        {
          "type": "collection_tile",
          "settings": {
            "title": "FOOTWEAR & OBJECTS",
            "subtitle": "EDITION RELEASES",
            "width": "standard"
          }
        }
      ]
    }
  ]
}
{% endschema %}
