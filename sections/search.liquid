{% comment %}
  ISHAYA Architectural Streetwear Search Section
{% endcomment %}

<div class="search-page page-container">
  <div class="search-page__header">
    <h1 class="search-page__title">{{ 'search.title' | t }}</h1>

    <!-- Search Form -->
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <input type="hidden" name="type" value="product,article,page">
      <div class="search-page__input-wrapper">
        <span class="search-page__input-icon">
          {% render 'icons', name: 'search', width: 20, height: 20 %}
        </span>
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          class="search-page__input"
          placeholder="{{ 'search.placeholder' | t }}"
          autocomplete="off"
        >
        <button type="submit" class="search-page__submit btn btn--primary">
          {{ 'search.submit' | t }}
        </button>
      </div>
    </form>

    {% if search.performed %}
      <div class="search-page__status">
        {% if search.results_count == 0 %}
          <p class="search-page__count">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
        {% else %}
          <p class="search-page__count">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% if search.performed and search.results_count > 0 %}
    {% paginate search.results by 24 %}
      <div class="search-results-grid">
        {% for result in search.results %}
          <div class="search-card glass-panel">
            <a href="{{ result.url }}" class="search-card__media-link" aria-label="{{ result.title | escape }}">
              {% assign featured_image = result.featured_image | default: result.image %}
              {% if featured_image %}
                <div class="search-card__image-box">
                  {{ featured_image | image_url: width: 600 | image_tag:
                    class: 'search-card__image',
                    loading: 'lazy',
                    alt: featured_image.alt | default: result.title | escape
                  }}
                </div>
              {% else %}
                <div class="search-card__placeholder">
                  {% render 'icon-ishaya-logo', class: 'search-card__placeholder-logo', width: 80, height: 16 %}
                </div>
              {% endif %}
            </a>

            <div class="search-card__content">
              <span class="search-card__type">
                {% if result.object_type == 'product' %}
                  {{ 'general.product' | t }}
                {% elsif result.object_type == 'article' %}
                  {{ 'general.article' | t }}
                {% else %}
                  {{ 'general.page' | t }}
                {% endif %}
              </span>

              <h2 class="search-card__title">
                <a href="{{ result.url }}" class="search-card__link">
                  {{ result.title }}
                </a>
              </h2>

              {% if result.price %}
                <div class="search-card__price">
                  {% if result.compare_at_price > result.price %}
                    <span class="search-card__compare-price">{{ result.compare_at_price | money }}</span>
                  {% endif %}
                  <span class="search-card__regular-price">{{ result.price | money }}</span>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="search-pagination">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  {% elsif search.performed and search.results_count == 0 %}
    <div class="search-empty glass-panel">
      <h2 class="search-empty__title">Nothing Found</h2>
      <p class="search-empty__text">Check spelling or search for something broader, such as "hoodie", "denim", or "jacket".</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">
        {{ '404.back_to_shopping' | t }}
      </a>
    </div>
  {% endif %}
</div>

<style>
  .search-page {
    padding-top: 3.5rem;
    padding-bottom: 6rem;
  }
  .search-page__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .search-page__title {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .search-page__form {
    width: 100%;
  }
  .search-page__input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.5rem 0.35rem 1.25rem;
    transition: border-color var(--transition-fast);
  }
  .search-page__input-wrapper:focus-within {
    border-color: var(--color-foreground);
  }
  .search-page__input-icon {
    color: var(--color-muted);
    display: flex;
    align-items: center;
  }
  .search-page__input {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    outline: none !important;
    font-size: 1rem;
    flex: 1;
    padding: 0.5rem 0 !important;
  }
  .search-page__submit {
    min-height: 42px;
    padding: 0.5rem 1.5rem;
    font-size: 0.75rem;
    flex-shrink: 0;
  }
  .search-page__status {
    margin-top: 1.5rem;
  }
  .search-page__count {
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* Grid */
  .search-results-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 600px) {
    .search-results-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .search-results-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
  @media (min-width: 1280px) {
    .search-results-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Search Cards */
  .search-card {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }
  .search-card:hover {
    transform: translateY(-4px);
    border-color: var(--glass-border);
  }
  .search-card__media-link {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--color-background);
    overflow: hidden;
    position: relative;
  }
  .search-card__image-box {
    width: 100%;
    height: 100%;
  }
  .search-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .search-card:hover .search-card__image {
    transform: scale(1.04);
  }
  .search-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--glass-bg);
  }
  .search-card__placeholder-logo {
    opacity: 0.2;
    color: var(--color-foreground);
  }
  .search-card__content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
  }
  .search-card__type {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .search-card__title {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
  }
  .search-card__link {
    color: var(--color-foreground);
    text-decoration: none;
  }
  .search-card__price {
    margin-top: auto;
    padding-top: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .search-card__compare-price {
    text-decoration: line-through;
    color: var(--color-muted);
  }
  .search-card__regular-price {
    color: var(--color-foreground);
  }

  /* Empty State */
  .search-empty {
    max-width: 580px;
    margin: 2rem auto;
    padding: 3.5rem 2rem;
    text-align: center;
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .search-empty__title {
    font-size: 1.5rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .search-empty__text {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Pagination */
  .search-pagination {
    margin-top: 3.5rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .search-pagination .page,
  .search-pagination .prev,
  .search-pagination .next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-muted);
    text-decoration: none;
    transition: all var(--transition-fast);
  }
  .search-pagination .current {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);
  }
  .search-pagination a:hover {
    border-color: var(--color-foreground);
    color: var(--color-foreground);
  }
</style>

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
