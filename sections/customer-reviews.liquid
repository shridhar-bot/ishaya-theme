{% comment %}
  320ISHAYA - Premium Customer Review Slider
  Compact cards + autoplay video + pagination + light/dark support
{% endcomment %}

<section
  id="ishaya-reviews-{{ section.id }}"
  class="ishaya-reviews-section"
>
  <div class="ishaya-reviews-container">

    <!-- ================= HEADER ================= -->

    <div class="ishaya-reviews-header">

      <div class="ishaya-reviews-heading">

        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading }}</p>
        {% endif %}

      </div>


      {% if section.blocks.size > 1 %}

        <div class="ishaya-review-arrows">

          <button
            type="button"
            class="ishaya-arrow ishaya-prev"
            aria-label="Previous reviews"
          >
            ←
          </button>

          <button
            type="button"
            class="ishaya-arrow ishaya-next"
            aria-label="Next reviews"
          >
            →
          </button>

        </div>

      {% endif %}

    </div>


    <!-- ================= SLIDER ================= -->

    <div class="ishaya-review-slider">

      {% for block in section.blocks %}

        <article
          class="ishaya-review-card"
          data-review-card
          {{ block.shopify_attributes }}
        >

          <!-- ================= MEDIA ================= -->

          {% if block.settings.review_video != blank %}

            <div class="ishaya-review-media">

              {{
                block.settings.review_video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  playsinline: true,
                  controls: false,
                  preload: 'metadata',
                  class: 'ishaya-review-video'
              }}

            </div>


          {% elsif block.settings.review_photo != blank %}

            <div class="ishaya-review-media">

              {{
                block.settings.review_photo
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 500, 800',
                  class: 'ishaya-review-photo',
                  alt: block.settings.customer_name
              }}

            </div>

          {% endif %}


          <!-- ================= CONTENT ================= -->

          <div class="ishaya-review-content">


            <!-- STARS -->

            <div
              class="ishaya-stars"
              aria-label="{{ block.settings.rating }} out of 5 stars"
            >

              {% assign rating = block.settings.rating | plus: 0 %}

              {% for i in (1..5) %}

                {% if i <= rating %}
                  <span class="active">★</span>
                {% else %}
                  <span class="inactive">★</span>
                {% endif %}

              {% endfor %}

            </div>


            <!-- REVIEW TITLE -->

            {% if block.settings.review_title != blank %}

              <h3 class="ishaya-review-title">
                {{ block.settings.review_title }}
              </h3>

            {% endif %}


            <!-- REVIEW TEXT -->

            {% if block.settings.review_text != blank %}

              <div class="ishaya-review-text">
                {{ block.settings.review_text }}
              </div>

            {% endif %}


            <!-- ================= CUSTOMER ================= -->

            <div class="ishaya-customer">


              <!-- PROFILE PHOTO -->

              {% if block.settings.customer_image != blank %}

                <div class="ishaya-avatar">

                  {{
                    block.settings.customer_image
                    | image_url: width: 100
                    | image_tag:
                      loading: 'lazy',
                      alt: block.settings.customer_name
                  }}

                </div>

              {% else %}

                <div class="ishaya-avatar ishaya-avatar-letter">

                  {{ block.settings.customer_name | slice: 0 | upcase }}

                </div>

              {% endif %}


              <!-- CUSTOMER DETAILS -->

              <div class="ishaya-customer-info">

                <div class="ishaya-customer-name">

                  <strong>
                    {{ block.settings.customer_name }}
                  </strong>


                  {% if block.settings.verified %}

                    <span
                      class="ishaya-verified"
                      title="Verified Buyer"
                    >
                      ✓
                    </span>

                  {% endif %}

                </div>


                <div class="ishaya-review-meta">

                  {% if block.settings.location != blank %}

                    <span>
                      {{ block.settings.location }}
                    </span>

                  {% endif %}


                  {% if block.settings.date != blank %}

                    {% if block.settings.location != blank %}
                      <span class="ishaya-meta-dot">•</span>
                    {% endif %}

                    <span>
                      {{ block.settings.date }}
                    </span>

                  {% endif %}

                </div>

              </div>

            </div>

          </div>

        </article>

      {% endfor %}

    </div>


    <!-- ================= PAGINATION ================= -->

    {% if section.blocks.size > 1 %}

      <div
        class="ishaya-pagination"
        aria-label="Review slider pagination"
      >

        {% for block in section.blocks %}

          <button
            type="button"
            class="ishaya-pagination-dot{% if forloop.first %} active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="Review {{ forloop.index }}"
          ></button>

        {% endfor %}

      </div>

    {% endif %}


    <!-- EMPTY STATE -->

    {% if section.blocks.size == 0 %}

      <div class="ishaya-empty-reviews">
        Add customer reviews from Theme Editor.
      </div>

    {% endif %}

  </div>
</section>



<style>

/* =========================================================
   MAIN SECTION
========================================================= */

#ishaya-reviews-{{ section.id }} {

  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));

  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;

  overflow: hidden;

}


#ishaya-reviews-{{ section.id }} * {
  box-sizing: border-box;
}


/* =========================================================
   CONTAINER
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-reviews-container {

  width: min(calc(100% - 40px), 1400px);

  margin: 0 auto;

}


/* =========================================================
   HEADER
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-reviews-header {

  display: flex;

  justify-content: space-between;
  align-items: flex-end;

  gap: 20px;

  margin-bottom: 24px;

}


#ishaya-reviews-{{ section.id }}
.ishaya-reviews-heading h2 {

  margin: 0;

  color: rgb(var(--color-foreground));

  font-size: clamp(25px, 2.4vw, 38px);

  line-height: 1.1;

  letter-spacing: -0.03em;

}


#ishaya-reviews-{{ section.id }}
.ishaya-reviews-heading p {

  margin: 7px 0 0;

  color: rgba(var(--color-foreground), 0.65);

  font-size: 13px;

  line-height: 1.5;

}


/* =========================================================
   ARROWS
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-review-arrows {

  display: flex;

  gap: 8px;

  flex-shrink: 0;

}


#ishaya-reviews-{{ section.id }}
.ishaya-arrow {

  display: flex;

  justify-content: center;
  align-items: center;

  width: 40px;
  height: 40px;

  padding: 0;

  background: rgb(var(--color-background));

  color: rgb(var(--color-foreground));

  border: 1px solid rgba(var(--color-foreground), 0.35);

  border-radius: 50%;

  font-size: 18px;

  line-height: 1;

  cursor: pointer;

  transition: all 0.2s ease;

}


#ishaya-reviews-{{ section.id }}
.ishaya-arrow:hover {

  background: rgb(var(--color-foreground));

  color: rgb(var(--color-background));

  border-color: rgb(var(--color-foreground));

}


/* =========================================================
   SLIDER
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-review-slider {

  display: flex;

  gap: {{ section.settings.card_gap }}px;

  overflow-x: auto;
  overflow-y: hidden;

  scroll-snap-type: x mandatory;

  scroll-behavior: smooth;

  scrollbar-width: none;

  -webkit-overflow-scrolling: touch;

  padding: 4px 3px 12px;

}


#ishaya-reviews-{{ section.id }}
.ishaya-review-slider::-webkit-scrollbar {

  display: none;

}


/* =========================================================
   REVIEW CARD - IMPORTANT BOX
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-review-card {

  flex:
    0 0
    calc(
      (100% - ({{ section.settings.card_gap }}px * 3))
      / 4
    );

  min-width: 0;

  display: flex;

  flex-direction: column;

  scroll-snap-align: start;

  overflow: hidden;


  /*
    CARD BACKGROUND

    Slight contrast from main section.
    Works with both light and dark themes.
  */

  background:
    rgba(var(--color-foreground), 0.045);


  color:
    rgb(var(--color-foreground));


  /*
    STRONG VISIBLE BORDER
  */

  border:
    {{ section.settings.border_width }}px
    solid
    rgba(
      var(--color-foreground),
      {{ section.settings.border_opacity | divided_by: 100.0 }}
    );


  border-radius:
    {{ section.settings.card_radius }}px;


  /*
    SHADOW MAKES BOX CLEAR
  */

  box-shadow:
    0 4px 18px
    rgba(0, 0, 0, 0.10);


  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;

}


#ishaya-reviews-{{ section.id }}
.ishaya-review-card:hover {

  transform: translateY(-3px);

  border-color:
    rgba(var(--color-foreground), 0.60);

  box-shadow:
    0 9px 28px
    rgba(0, 0, 0, 0.15);

}


/* =========================================================
   MEDIA
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-review-media {

  position: relative;

  width: 100%;

  height:
    {{ section.settings.media_height }}px;

  overflow: hidden;

  background:
    rgba(var(--color-foreground), 0.08);

  border-bottom:
    1px solid
    rgba(var(--color-foreground), 0.22);

}


#ishaya-reviews-{{ section.id }}
.ishaya-review-photo,

#ishaya-reviews-{{ section.id }}
.ishaya-review-video {

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

}


/* =========================================================
   REVIEW CONTENT
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-review-content {

  display: flex;

  flex-direction: column;

  flex: 1;

  padding:
    {{ section.settings.card_padding }}px;

}


/* =========================================================
   STARS
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-stars {

  display: flex;

  align-items: center;

  gap: 2px;

  font-size: 16px;

  line-height: 1;

}


#ishaya-reviews-{{ section.id }}
.ishaya-stars .active {

  color:
    {{ section.settings.star_color }};

}


#ishaya-reviews-{{ section.id }}
.ishaya-stars .inactive {

  color:
    rgba(var(--color-foreground), 0.22);

}


/* =========================================================
   REVIEW TITLE
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-review-title {

  margin: 12px 0 0;

  color:
    rgb(var(--color-foreground));

  font-size: 15px;

  font-weight: 700;

  line-height: 1.35;

  letter-spacing: 0.04em;

}


/* =========================================================
   REVIEW TEXT
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-review-text {

  margin-top: 8px;

  color:
    rgba(var(--color-foreground), 0.75);

  font-size: 12.5px;

  line-height: 1.6;

}


#ishaya-reviews-{{ section.id }}
.ishaya-review-text p {

  margin: 0;

}


/* =========================================================
   CUSTOMER AREA
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-customer {

  display: flex;

  align-items: center;

  gap: 10px;

  margin-top: auto;

  padding-top: 16px;

  border-top:
    1px solid
    rgba(var(--color-foreground), 0.15);

}


/* =========================================================
   CUSTOMER PROFILE IMAGE
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-avatar {

  width: 36px;
  height: 36px;

  flex: 0 0 36px;

  overflow: hidden;

  border-radius: 50%;

  border:
    1px solid
    rgba(var(--color-foreground), 0.20);

}


#ishaya-reviews-{{ section.id }}
.ishaya-avatar img {

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

}


/* CUSTOMER LETTER */

#ishaya-reviews-{{ section.id }}
.ishaya-avatar-letter {

  display: flex;

  justify-content: center;
  align-items: center;

  background:
    rgb(var(--color-foreground));

  color:
    rgb(var(--color-background));

  font-size: 12px;

  font-weight: 700;

}


/* =========================================================
   CUSTOMER NAME
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-customer-info {

  min-width: 0;

}


#ishaya-reviews-{{ section.id }}
.ishaya-customer-name {

  display: flex;

  align-items: center;

  gap: 6px;

  color:
    rgb(var(--color-foreground));

  font-size: 12px;

  line-height: 1.3;

}


/* =========================================================
   VERIFIED
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-verified {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  width: 16px;
  height: 16px;

  flex: 0 0 16px;

  border-radius: 50%;

  background:
    rgb(var(--color-foreground));

  color:
    rgb(var(--color-background));

  font-size: 9px;

  font-weight: 700;

}


/* =========================================================
   META
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-review-meta {

  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: 5px;

  margin-top: 3px;

  color:
    rgba(var(--color-foreground), 0.55);

  font-size: 10px;

  line-height: 1.3;

}


/* =========================================================
   PAGINATION
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-pagination {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 7px;

  margin-top: 14px;

}


#ishaya-reviews-{{ section.id }}
.ishaya-pagination-dot {

  width: 7px;
  height: 7px;

  min-width: 7px;

  padding: 0;

  border: 0;

  border-radius: 50px;

  background:
    rgba(var(--color-foreground), 0.28);

  cursor: pointer;

  transition:
    width 0.25s ease,
    background 0.25s ease;

}


#ishaya-reviews-{{ section.id }}
.ishaya-pagination-dot.active {

  width: 25px;

  background:
    rgb(var(--color-foreground));

}


/* =========================================================
   EMPTY
========================================================= */

#ishaya-reviews-{{ section.id }}
.ishaya-empty-reviews {

  padding: 30px;

  text-align: center;

  border:
    1px dashed
    rgba(var(--color-foreground), 0.30);

  border-radius: 10px;

}


/* =========================================================
   TABLET
========================================================= */

@media screen and (max-width: 990px) {

  #ishaya-reviews-{{ section.id }}
  .ishaya-review-card {

    flex:
      0 0
      calc(
        (100% - {{ section.settings.card_gap }}px)
        / 2
      );

  }

}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 749px) {

  #ishaya-reviews-{{ section.id }} {

    padding-top:
      {{ section.settings.mobile_padding_top }}px;

    padding-bottom:
      {{ section.settings.mobile_padding_bottom }}px;

  }


  #ishaya-reviews-{{ section.id }}
  .ishaya-reviews-container {

    width: 100%;

  }


  #ishaya-reviews-{{ section.id }}
  .ishaya-reviews-header {

    align-items: center;

    padding-left: 16px;
    padding-right: 16px;

    margin-bottom: 18px;

  }


  #ishaya-reviews-{{ section.id }}
  .ishaya-reviews-heading h2 {

    font-size: 23px;

  }


  #ishaya-reviews-{{ section.id }}
  .ishaya-reviews-heading p {

    margin-top: 5px;

    font-size: 11px;

  }


  /* Mobile swipe instead of arrows */

  #ishaya-reviews-{{ section.id }}
  .ishaya-review-arrows {

    display: none;

  }


  #ishaya-reviews-{{ section.id }}
  .ishaya-review-slider {

    gap: 12px;

    padding-left: 16px;
    padding-right: 16px;

    padding-bottom: 10px;

  }


  /* One card + preview of next */

  #ishaya-reviews-{{ section.id }}
  .ishaya-review-card {

    flex: 0 0 84%;

    box-shadow:
      0 4px 15px
      rgba(0, 0, 0, 0.10);

  }


  #ishaya-reviews-{{ section.id }}
  .ishaya-review-media {

    height:
      {{ section.settings.mobile_media_height }}px;

  }


  #ishaya-reviews-{{ section.id }}
  .ishaya-review-content {

    padding:
      {{ section.settings.mobile_card_padding }}px;

  }


  #ishaya-reviews-{{ section.id }}
  .ishaya-review-title {

    font-size: 14px;

  }


  #ishaya-reviews-{{ section.id }}
  .ishaya-review-text {

    font-size: 12px;

  }


  #ishaya-reviews-{{ section.id }}
  .ishaya-pagination {

    margin-top: 10px;

  }

}
/* =====================================================
   ISHAYA REVIEW CARD
   VISIBLE BOX + AUTOMATIC LIGHT/DARK THEME
===================================================== */


/* MAIN SECTION */

#ishaya-reviews-{{ section.id }} {
  background: rgb(var(--color-background)) !important;
  color: rgb(var(--color-foreground)) !important;
}


/* =====================================================
   CARD BOX
===================================================== */

#ishaya-reviews-{{ section.id }} .ishaya-review-card {

  position: relative !important;

  background: rgb(var(--color-background)) !important;

  color: rgb(var(--color-foreground)) !important;

  border: 1px solid currentColor !important;

  border-radius: 12px !important;

  overflow: hidden !important;

  box-shadow: none !important;

}


/* Softer border without losing the box */

#ishaya-reviews-{{ section.id }} .ishaya-review-card {
  border-color:
    color-mix(
      in srgb,
      currentColor 28%,
      transparent
    ) !important;
}


/* HOVER */

#ishaya-reviews-{{ section.id }} .ishaya-review-card:hover {

  border-color:
    color-mix(
      in srgb,
      currentColor 55%,
      transparent
    ) !important;

  box-shadow: none !important;

}


/* =====================================================
   CARD CONTENT
===================================================== */

#ishaya-reviews-{{ section.id }} .ishaya-review-content {

  background: transparent !important;

  color: inherit !important;

}


/* TITLE */

#ishaya-reviews-{{ section.id }} .ishaya-review-title {

  color: inherit !important;

}


/* REVIEW TEXT */

#ishaya-reviews-{{ section.id }} .ishaya-review-text {

  color: inherit !important;

  opacity: 0.72;

}


/* =====================================================
   CUSTOMER AREA
===================================================== */

#ishaya-reviews-{{ section.id }} .ishaya-customer {

  border-top:
    1px solid
    color-mix(
      in srgb,
      currentColor 15%,
      transparent
    ) !important;

}


/* CUSTOMER NAME */

#ishaya-reviews-{{ section.id }} .ishaya-customer-name {

  color: inherit !important;

}


/* DATE + LOCATION */

#ishaya-reviews-{{ section.id }} .ishaya-review-meta {

  color: inherit !important;

  opacity: 0.55;

}


/* =====================================================
   CUSTOMER PROFILE
===================================================== */

#ishaya-reviews-{{ section.id }} .ishaya-avatar {

  border:
    1px solid
    color-mix(
      in srgb,
      currentColor 20%,
      transparent
    ) !important;

}


/* CUSTOMER LETTER */

#ishaya-reviews-{{ section.id }} .ishaya-avatar-letter {

  background: currentColor !important;

}


/* =====================================================
   MEDIA
===================================================== */

#ishaya-reviews-{{ section.id }} .ishaya-review-media {

  background:
    color-mix(
      in srgb,
      currentColor 5%,
      transparent
    ) !important;

  border-bottom:
    1px solid
    color-mix(
      in srgb,
      currentColor 15%,
      transparent
    ) !important;

}


/* =====================================================
   HEADER
===================================================== */

#ishaya-reviews-{{ section.id }} .ishaya-reviews-heading h2 {

  color: inherit !important;

}


#ishaya-reviews-{{ section.id }} .ishaya-reviews-heading p {

  color: inherit !important;

  opacity: 0.62;

}


/* =====================================================
   ARROWS
===================================================== */



/* =====================================================
   PAGINATION
===================================================== */

#ishaya-reviews-{{ section.id }} .ishaya-pagination-dot {

  background: currentColor !important;

  opacity: 0.25;

}


#ishaya-reviews-{{ section.id }} .ishaya-pagination-dot.active {

  background: currentColor !important;

  opacity: 1;

}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {

  #ishaya-reviews-{{ section.id }} .ishaya-review-card {

    border-width: 1px !important;

    border-color:
      color-mix(
        in srgb,
        currentColor 32%,
        transparent
      ) !important;

  }

}
/* =====================================================
   ISHAYA VERTICAL VIDEO REVIEW CARD
   Compact vertical card - no side empty space
===================================================== */

/* ONLY CARD WHICH CONTAINS VIDEO */
#ishaya-reviews-{{ section.id }} .ishaya-review-card:has(video) {
  flex-basis: 300px !important;
  width: 300px !important;
  max-width: 300px !important;
}


/* VIDEO MEDIA AREA */
#ishaya-reviews-{{ section.id }} .ishaya-review-card:has(video)
.ishaya-review-media {

  width: 100% !important;

  height: 330px !important;
  min-height: 330px !important;
  max-height: 330px !important;

  display: block !important;

  overflow: hidden !important;

  padding: 0 !important;
  margin: 0 !important;

  background: transparent !important;
}


/* VIDEO FULL CARD WIDTH */
#ishaya-reviews-{{ section.id }} .ishaya-review-card:has(video)
.ishaya-review-media video,

#ishaya-reviews-{{ section.id }} .ishaya-review-card:has(video)
.ishaya-review-video {

  display: block !important;

  width: 100% !important;
  height: 100% !important;

  max-width: none !important;

  aspect-ratio: auto !important;

  object-fit: cover !important;

  object-position: center center !important;

  margin: 0 !important;
  padding: 0 !important;

  border-radius: 0 !important;
}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {

  #ishaya-reviews-{{ section.id }} .ishaya-review-card:has(video) {

    flex-basis: 82% !important;

    width: 82% !important;
    max-width: 320px !important;

  }


  #ishaya-reviews-{{ section.id }} .ishaya-review-card:has(video)
  .ishaya-review-media {

    height: 340px !important;
    min-height: 340px !important;
    max-height: 340px !important;

  }

}
/* =====================================================
   REVIEW TEXT - 3 LINE LIMIT + CLICK TO EXPAND
===================================================== */

#ishaya-reviews-{{ section.id }} .ishaya-review-text {
  display: -webkit-box !important;
  -webkit-box-orient: vertical !important;
  -webkit-line-clamp: 3 !important;

  overflow: hidden !important;
  text-overflow: ellipsis !important;

  line-height: 1.55 !important;

  /* 3 lines માટે fixed space */
  min-height: calc(1.55em * 3);
  max-height: calc(1.55em * 3);

  cursor: pointer;
}


/* FULL REVIEW OPEN */
#ishaya-reviews-{{ section.id }} .ishaya-review-text.is-expanded {
  display: block !important;

  -webkit-line-clamp: unset !important;

  overflow: visible !important;

  max-height: none !important;
  min-height: calc(1.55em * 3);

  cursor: pointer;
}
/* ==========================================
   REVIEW ARROWS - LIGHT / DARK MODE
========================================== */

/* NORMAL ARROW */
#ishaya-reviews-{{ section.id }} .ishaya-arrow {
  background: transparent !important;
  color: rgb(var(--color-foreground)) !important;

  border: 1px solid
    rgba(var(--color-foreground), 0.35) !important;
}


/* HOVER
   Automatically reverses theme colors
*/
#ishaya-reviews-{{ section.id }} .ishaya-arrow:hover {

  background: rgb(var(--color-foreground)) !important;

  color: rgb(var(--color-background)) !important;

  border-color: rgb(var(--color-foreground)) !important;
}


/* SVG ARROW */
#ishaya-reviews-{{ section.id }} .ishaya-arrow:hover svg,
#ishaya-reviews-{{ section.id }} .ishaya-arrow:hover svg path {

  stroke: rgb(var(--color-background)) !important;
}


/* TEXT ARROW ← → */
#ishaya-reviews-{{ section.id }} .ishaya-arrow:hover span {

  color: rgb(var(--color-background)) !important;
}
/* ==========================================
   ARROW HOVER COLOR FIX ONLY
   Original circle/design remains unchanged
========================================== */

/* Hover */
#ishaya-reviews-{{ section.id }} .ishaya-arrow:hover {
  background-color: rgb(var(--color-foreground)) !important;
  color: rgb(var(--color-background)) !important;
}

/* If arrow is inside span */
#ishaya-reviews-{{ section.id }} .ishaya-arrow:hover span {
  color: rgb(var(--color-background)) !important;
}

/* If arrow is SVG */
#ishaya-reviews-{{ section.id }} .ishaya-arrow:hover svg,
#ishaya-reviews-{{ section.id }} .ishaya-arrow:hover svg path {
  stroke: rgb(var(--color-background)) !important;
  color: rgb(var(--color-background)) !important;
}
/* =====================================================
   REVIEW HEADER - LATEST DROPS STYLE
   AUTO LIGHT / DARK MODE
===================================================== */

/* MAIN HEADING */
#ishaya-reviews-{{ section.id }} .ishaya-reviews-heading h2 {
  margin: 0 !important;

  color: rgb(var(--color-foreground)) !important;

  font-size: clamp(34px, 3.4vw, 52px) !important;
  font-weight: 800 !important;

  line-height: 1.05 !important;
  letter-spacing: -0.035em !important;

  text-transform: uppercase !important;
}


/* SUBHEADING */
#ishaya-reviews-{{ section.id }} .ishaya-reviews-heading p {
  margin: 14px 0 0 !important;

  color: rgb(var(--color-foreground)) !important;
  opacity: 0.48 !important;

  font-size: 15px !important;
  font-weight: 400 !important;

  line-height: 1.5 !important;
  letter-spacing: 0.015em !important;
}


/* MOBILE */
@media screen and (max-width: 749px) {

  #ishaya-reviews-{{ section.id }} .ishaya-reviews-heading h2 {
    font-size: 30px !important;
    line-height: 1.08 !important;
  }

  #ishaya-reviews-{{ section.id }} .ishaya-reviews-heading p {
    margin-top: 10px !important;
    font-size: 13px !important;
  }

}
</style>



<script>
    /* ==========================================
   REVIEW TEXT - CLICK TO READ FULL REVIEW
========================================== */

document
  .querySelectorAll(
    '#ishaya-reviews-{{ section.id }} .ishaya-review-text'
  )
  .forEach(function(reviewText) {

    reviewText.setAttribute('role', 'button');
    reviewText.setAttribute('tabindex', '0');
    reviewText.setAttribute('aria-expanded', 'false');


    function toggleReview() {

      var isExpanded =
        reviewText.classList.toggle('is-expanded');

      reviewText.setAttribute(
        'aria-expanded',
        isExpanded ? 'true' : 'false'
      );

    }


    reviewText.addEventListener(
      'click',
      toggleReview
    );


    reviewText.addEventListener(
      'keydown',
      function(event) {

        if (
          event.key === 'Enter' ||
          event.key === ' '
        ) {

          event.preventDefault();

          toggleReview();

        }

      }
    );

  });
(function () {

  const sectionId =
    'ishaya-reviews-{{ section.id }}';


  function initReviewSlider() {

    const section =
      document.getElementById(sectionId);

    if (!section) return;


    const slider =
      section.querySelector(
        '.ishaya-review-slider'
      );


    const cards =
      Array.from(
        section.querySelectorAll(
          '[data-review-card]'
        )
      );


    const dots =
      Array.from(
        section.querySelectorAll(
          '.ishaya-pagination-dot'
        )
      );


    const previousButton =
      section.querySelector(
        '.ishaya-prev'
      );


    const nextButton =
      section.querySelector(
        '.ishaya-next'
      );


    if (!slider || !cards.length) {
      return;
    }


    /* ===============================
       AUTOPLAY VIDEOS
    =============================== */

    const videos =
      section.querySelectorAll(
        '.ishaya-review-video'
      );


    videos.forEach(function(video) {

      video.muted = true;

      video.setAttribute(
        'muted',
        ''
      );

      video.setAttribute(
        'playsinline',
        ''
      );

      video.setAttribute(
        'autoplay',
        ''
      );

      video.setAttribute(
        'loop',
        ''
      );


      const playPromise =
        video.play();


      if (
        playPromise !== undefined
      ) {

        playPromise.catch(
          function() {

            /* Browser may delay autoplay */

          }
        );

      }

    });


    /* ===============================
       GET CARD STEP
    =============================== */

    function getGap() {

      const styles =
        window.getComputedStyle(
          slider
        );

      return (
        parseFloat(styles.gap) || 0
      );

    }


    function getStep() {

      if (!cards[0]) {
        return 300;
      }

      return (
        cards[0].getBoundingClientRect().width
        +
        getGap()
      );

    }


    /* ===============================
       CURRENT CARD
    =============================== */

    function getCurrentIndex() {

      const step =
        getStep();


      if (!step) {
        return 0;
      }


      return Math.max(
        0,
        Math.min(
          cards.length - 1,
          Math.round(
            slider.scrollLeft / step
          )
        )
      );

    }


    /* ===============================
       PAGINATION
    =============================== */

    function updatePagination() {

      const current =
        getCurrentIndex();


      dots.forEach(
        function(dot, index) {

          dot.classList.toggle(
            'active',
            index === current
          );

        }
      );

    }


    /* ===============================
       GO TO REVIEW
    =============================== */

    function goToReview(index) {

      if (!cards[index]) {
        return;
      }


      slider.scrollTo({

        left:
          cards[index].offsetLeft
          -
          slider.offsetLeft,

        behavior: 'smooth'

      });

    }


    /* ===============================
       NEXT
    =============================== */

    if (nextButton) {

      nextButton.addEventListener(
        'click',
        function() {

          let nextIndex =
            getCurrentIndex() + 1;


          if (
            nextIndex >= cards.length
          ) {

            nextIndex = 0;

          }


          goToReview(
            nextIndex
          );

        }
      );

    }


    /* ===============================
       PREVIOUS
    =============================== */

    if (previousButton) {

      previousButton.addEventListener(
        'click',
        function() {

          let previousIndex =
            getCurrentIndex() - 1;


          if (
            previousIndex < 0
          ) {

            previousIndex =
              cards.length - 1;

          }


          goToReview(
            previousIndex
          );

        }
      );

    }


    /* ===============================
       DOT CLICK
    =============================== */

    dots.forEach(
      function(dot, index) {

        dot.addEventListener(
          'click',
          function() {

            goToReview(index);

          }
        );

      }
    );


    /* ===============================
       UPDATE ON SCROLL
    =============================== */

    let scrollTimer;


    slider.addEventListener(
      'scroll',
      function() {

        clearTimeout(
          scrollTimer
        );


        scrollTimer =
          setTimeout(
            updatePagination,
            50
          );

      },
      {
        passive: true
      }
    );


    /* ===============================
       WINDOW RESIZE
    =============================== */

    window.addEventListener(
      'resize',
      updatePagination
    );


    updatePagination();

  }


  /* NORMAL WEBSITE LOAD */

  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initReviewSlider
    );

  } else {

    initReviewSlider();

  }


  /* SHOPIFY THEME EDITOR */

  document.addEventListener(
    'shopify:section:load',
    function(event) {

      if (
        event.target &&
        event.target.querySelector(
          '#' + sectionId
        )
      ) {

        initReviewSlider();

      }

    }
  );

})();
</script>



