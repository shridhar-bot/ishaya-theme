[
  {
    "name": "theme_info",
    "theme_name": "Ishaya",
    "theme_version": "1.0.0",
    "theme_author": "Ishaya Apparel",
    "theme_documentation_url": "https://github.com/shridhar-bot/ishaya-theme",
    "theme_support_url": "https://github.com/shridhar-bot/ishaya-theme"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n7",
        "label": "t:labels.heading_font"
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "min": 0,
        "max": 6,
        "step": 0.5,
        "unit": "px",
        "label": "t:labels.heading_letter_spacing",
        "default": 2
      },
      {
        "type": "checkbox",
        "id": "heading_uppercase",
        "label": "t:labels.heading_uppercase",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#09090b",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#f4f4f5",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#71717a",
        "label": "t:labels.muted_color"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#27272a",
        "label": "t:labels.border_color"
      },
      {
        "type": "color",
        "id": "surface_color",
        "default": "#121215",
        "label": "t:labels.surface_color"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#ffffff",
        "label": "t:labels.accent_color"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "80rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "90rem",
            "label": "t:options.page_width.standard"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 12,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 6
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "t:labels.button_corner_radius",
        "default": 24
      }
    ]
  },
  {
    "name": "t:general.brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 5,
        "unit": "px",
        "label": "t:labels.logo_width",
        "default": 130
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "t:labels.social_instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "t:labels.social_tiktok"
      },
      {
        "type": "url",
        "id": "social_x_link",
        "label": "t:labels.social_x"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "t:labels.social_youtube"
      },
      {
        "type": "url",
        "id": "social_spotify_link",
        "label": "t:labels.social_spotify"
      }
    ]
  },
  {
    "name": "Cart & Checkout",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "Enable slide-out cart drawer",
        "default": true
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "min": 50,
        "max": 500,
        "step": 25,
        "unit": "$",
        "label": "Free shipping threshold",
        "default": 250
      },
      {
        "type": "checkbox",
        "id": "show_order_notes",
        "label": "Enable order notes in cart",
        "default": true
      }
    ]
  }
]
