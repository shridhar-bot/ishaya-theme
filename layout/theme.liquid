<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {% render 'css-variables' %}

    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% if settings.type_heading_font and settings.type_heading_font.family != settings.type_primary_font.family %}
      {% unless settings.type_heading_font.system? %}
        {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
      {% endunless %}
    {% endif %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'meta-tags' %}

    {{ content_for_header }}
    <style>
  /* Keep the offer strip and header wrappers transparent */
  #shopify-section-header,
  #shopify-section-header-group,
  .shopify-section-group-header-group {
    background: transparent !important;
  }

  /* Preserve the existing page layout */
  body {
    margin: 0;
  }
</style>  
  </head>

  <body>
    <a href="#main-content" class="skip-to-content">
      Skip to content
    </a>
    {% render 'ishaya-offer-bar' %}

    {% sections 'header-group' %}

    <main id="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}

    {% render 'wishlist-drawer' %}

    <script src="{{ 'product-card.js' | asset_url }}" defer="defer"></script>

    <script src="{{ 'theme-mode.js' | asset_url }}" defer="defer"></script>
    <script>
(function () {
  function updateHeaderPosition() {
    document.body.classList.toggle(
      'ishaya-scrolled',
      window.scrollY > 45
    );
  }

  window.addEventListener('scroll', updateHeaderPosition, { passive: true });
  updateHeaderPosition();
})();
</script>
  </body>
</html>
