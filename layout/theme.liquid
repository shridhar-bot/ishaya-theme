<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <link rel="canonical" href="{{ canonical_url }}">

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload critical font variants
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% if settings.type_heading_font and settings.type_heading_font.family != settings.type_primary_font.family %}
      {% unless settings.type_heading_font.system? %}
        {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
      {% endunless %}
    {% endif %}

    {% # Load and preload critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <a href="#main-content" class="skip-to-content">
      Skip to content
    </a>

    {% sections 'header-group' %}

    <main id="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% # Global Cart Drawer %}
    {% render 'cart-drawer' %}

    {% # Product card behaviour (quick add + wishlist) — delegated, bound once %}
    <script src="{{ 'product-card.js' | asset_url }}" defer="defer"></script>

    {% # Light/dark toggle interaction (pre-paint bootstrap is inline in css-variables) %}
    <script src="{{ 'theme-mode.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
